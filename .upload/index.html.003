","child-sprites.png":"data:image/png;base64,","protectors.png":"data:image/png;base64,","haulers.jpg":"data:image/jpeg;base64,","yamen.webp":"data:image/webp;base64,","varvara.webp":"data:image/webp;base64,"};window.LESSON_SCENES=[{"index":0,"id":"cover","title":"童年里，什么值得被留下","phase":"课前","time":"课前","type":"title"},{"index":1,"id":"today","title":"我们自己的童年","phase":"0—2分钟","time":"0:00—0:18","type":"intro"},{"index":2,"id":"ordinary","title":"快乐和烦恼都真实","phase":"0—2分钟","time":"0:18—0:30","type":"intro"},{"index":3,"id":"window","title":"推开另一扇窗","phase":"0—2分钟","time":"0:30—0:40","type":"intro"},{"index":4,"id":"arrival","title":"走进阿廖沙的世界","phase":"0—2分钟","time":"0:40—0:45","type":"intro"},{"index":5,"id":"initial","title":"留下暂时的判断","phase":"0—2分钟","time":"0:45—2:00","type":"question"},{"index":6,"id":"parallel","title":"两种影响","phase":"2—10分钟","time":"2:00—4:00","type":"reading"},{"index":7,"id":"compare","title":"怎样比较影响","phase":"2—10分钟","time":"4:00—10:00","type":"reading"},{"index":8,"id":"haulers","title":"看见沉重的劳动","phase":"10—13分钟","time":"10:00—10:40","type":"art"},{"index":9,"id":"grandfather","title":"经历与解释","phase":"10—13分钟","time":"10:40—12:30","type":"reading"},{"index":10,"id":"turnone","title":"记得自己的痛","phase":"10—13分钟","time":"12:30—13:00","type":"question"},{"index":11,"id":"rules","title":"阅读卡修复挑战","phase":"13—23分钟","time":"13:00—13:40","type":"rules"},{"index":12,"id":"r1read","title":"补回失踪的词","phase":"13—23分钟","time":"13:40—14:00","type":"reading"},{"index":13,"id":"r1recall","title":"记下一个词","phase":"13—23分钟","time":"14:00—14:20","type":"recall"},{"index":14,"id":"r1repair","title":"让概括更完整","phase":"13—23分钟","time":"14:20—16:10","type":"repair"},{"index":15,"id":"r2read","title":"检验因果线","phase":"13—23分钟","time":"16:10—16:30","type":"reading"},{"index":16,"id":"r2recall","title":"记下他的解释","phase":"13—23分钟","time":"16:30—16:38","type":"recall"},{"index":17,"id":"r2repair","title":"剪断不成立的箭头","phase":"13—23分钟","time":"16:38—18:40","type":"repair"},{"index":18,"id":"r3read","title":"读懂保护的动作","phase":"13—23分钟","time":"18:40—19:10","type":"reading"},{"index":19,"id":"r3recall","title":"记下一个动作","phase":"13—23分钟","time":"19:10—19:20","type":"recall"},{"index":20,"id":"r3repair","title":"把赞美写准确","phase":"13—23分钟","time":"19:20—21:40","type":"repair"},{"index":21,"id":"again","title":"还会打我吗","phase":"13—23分钟","time":"21:40—22:00","type":"question"},{"index":22,"id":"againanswer","title":"保护以后","phase":"13—23分钟","time":"22:00—23:00","type":"reading"},{"index":23,"id":"annecontext","title":"安妮的藏身生活","phase":"23—27分钟","time":"23:00—23:35","type":"context"},{"index":24,"id":"annehelp","title":"送进来的帮助","phase":"23—27分钟","time":"23:35—24:00","type":"context"},{"index":25,"id":"annewish","title":"普通的愿望","phase":"23—27分钟","time":"24:00—25:50","type":"reading"},{"index":26,"id":"annetwist","title":"为什么只能是愿望","phase":"23—27分钟","time":"25:50—27:00","type":"question"},{"index":27,"id":"group","title":"幸福童年最不能缺少什么","phase":"27—35分钟","time":"27:00—32:00","type":"discussion"},{"index":28,"id":"share","title":"让条件成为生活","phase":"27—35分钟","time":"32:00—35:00","type":"discussion"},{"index":29,"id":"author","title":"为什么写下这些事","phase":"35—38分钟","time":"35:00—36:00","type":"reading"},{"index":30,"id":"revise","title":"回到最初的判断","phase":"35—38分钟","time":"36:00—36:30","type":"question"},{"index":31,"id":"bubbles","title":"看见更多孩子","phase":"35—38分钟","time":"36:30—36:35","type":"bubbles"},{"index":32,"id":"yamen","title":"回到学校","phase":"35—38分钟","time":"36:35—36:50","type":"documentary"},{"index":33,"id":"varvara","title":"灯亮着的夜晚","phase":"35—38分钟","time":"36:50—37:05","type":"documentary"},{"index":34,"id":"pressure","title":"什么正在压着孩子","phase":"35—38分钟","time":"37:05—37:30","type":"pressure"},{"index":35,"id":"daily","title":"把目光带回身边","phase":"35—38分钟","time":"37:30—38:00","type":"question"},{"index":36,"id":"exit","title":"留下自己的三句话","phase":"38—40分钟","time":"38:00—39:30","type":"writing"},{"index":37,"id":"support","title":"共同撑开一点空间","phase":"38—40分钟","time":"39:30—39:38","type":"ending"},{"index":38,"id":"ending","title":"普通愿望 普通生活","phase":"38—40分钟","time":"39:38—39:52","type":"ending"},{"index":39,"id":"homework","title":"把阅读继续下去","phase":"38—40分钟","time":"39:52—40:00","type":"homework"}];window.LESSON_TEXT={"A":{"title":"受伤之后","blocks":["生病的那几天，是我一生中重大的日子。在这些日子里，我大概长得很快，并且有了一种特别不同的感觉。","从那时起，我怀着不安的心情观察人们，仿佛我心上的外皮给人撕掉了，于是，这颗心就变得对于一切屈辱和痛苦，不论是自己的或别人的，都难以忍受的敏感。"],"context_excerpt":"外祖父把我打得失去了知觉，接着我病了一场，在一间小屋里，背脊朝上，趴在暖和的大床上躺了几天；这间小屋只有一个窗户，在墙角，在盛着许多圣像的玻璃匣子前面，点着一盏通红的长明小灯。","game_excerpt":"从那时起，我怀着不安的心情观察人们，仿佛我心上的外皮给人撕掉了，于是，这颗心就变得对于一切屈辱和痛苦，不论是自己的或别人的，都难以忍受的敏感。","keywords":["不安","撕掉","难以忍受","自己的或别人的","敏感"]},"B":{"title":"外祖母带来的光","blocks":["在她没来以前，我仿佛是躲在黑暗中睡觉，但她一出现，就把我叫醒了，把我领到光明的地方，用一根不断的线把我周围的一切连结起来，织成五光十色的花边，她马上成为我终身的朋友，成为最知心的人，成为我最了解、最珍贵的人，——是她那对世界无私的爱丰富了我，使我充满了坚强的力量以应付困苦的生活的。"],"short_blocks":["在她没来以前，我仿佛是躲在黑暗中睡觉，但她一出现，就把我叫醒了，把我领到光明的地方","是她那对世界无私的爱丰富了我，使我充满了坚强的力量以应付困苦的生活的。"],"keywords":["无私的爱","丰富了我","坚强的力量","应付困苦的生活"]},"C":{"title":"另一个受过苦的人","blocks":["我当时对你太过分了，兄弟。","你要知道：挨自己亲人的打，这不算屈辱，是受教训！不要让外人打，自己人打没关系！","你以为我没有挨过打吗？阿廖沙，我挨的那个打啊，你连做噩梦都没有梦见过。我给人家欺辱成那个样子，大约上帝看见也会掉泪！结果怎么样呢？我这个孤儿，叫化子母亲的儿子，熬出头了，当上行会的头儿，手下管很多人。","船在水里走，我在岸上走，打着赤脚，脚底下是锐利的石块——山旁崩落的碎石，从日出走到深夜。","力量全使尽了啊，哪怕休息一会儿也好，哪怕咽了气儿也好！"],"short_blocks":["我当时对你太过分了，兄弟。","挨自己亲人的打，这不算屈辱，是受教训！","我给人家欺辱成那个样子，大约上帝看见也会掉泪！","我这个孤儿，叫化子母亲的儿子，熬出头了，当上行会的头儿，手下管很多人。"],"keywords":["太过分了","受教训","欺辱","熬出头了"]},"D":{"title":"伸出来的胳膊","blocks":["外祖父气疯了，我一看他要打你，就用这只胳膊挡着你，我指望这样一垫就可以把树条子折断，趁外祖父去拿另一条的工夫，外祖母或者你母亲就把你拖走了！","可是你总算少挨了几下，你瞧我给打的！","我同样也爱你啊，正因为这我才为你忍疼受苦，为了爱啊！"],"short_blocks":["我一看他要打你，就用这只胳膊挡着你","可是你总算少挨了几下","我同样也爱你啊，正因为这我才为你忍疼受苦，为了爱啊！"],"next_time_blocks":["下次再打你，记住，你别抱紧身子缩作一团，你懂吗？","还会打我吗？","你当不会吗？","当然要打啦！"],"next_time_dialogue":[{"speaker":"阿廖沙","text":"还会打我吗？"},{"speaker":"小茨冈","text":"当然要打啦！"}],"keywords":["挡着你","少挨了几下","为了爱"]},"E":{"title":"为什么写下这些事","blocks":["值得讲这些吗？","每一次我都重新怀着信心回答自己：值得，因为这是一种富有生命力的丑恶的真实，它直到今天还没有消灭。","这是一种要想从人的记忆、从灵魂、从我们一切沉重的可耻的生活中连根儿拔掉，就必须从根儿了解的真实。","虽然这些丑事令人作呕，虽然它们窒息我们，把无数美好的灵魂压扁，而俄罗斯人的灵魂仍然是那样健康，年轻，足以克服而且一定能克服它们。","生长着善良——人所固有的善良，这些东西唤起我们一种难以摧毁的希望，希望光明的、人道的生活终将苏生。"],"short_blocks":["值得讲这些吗？","这是一种要想从人的记忆、从灵魂、从我们一切沉重的可耻的生活中连根儿拔掉，就必须从根儿了解的真实。","虽然这些丑事令人作呕，虽然它们窒息我们，把无数美好的灵魂压扁","生长着善良——人所固有的善良，这些东西唤起我们一种难以摧毁的希望，希望光明的、人道的生活终将苏生。"],"keywords":["值得","连根儿拔掉","压扁","善良","光明的、人道的生活"]},"anne":{"title":"她想要的生活","blocks":["我渴望骑车、跳舞、吹口哨，看看世界，感受青春，知道自己是自由的。"],"wishes":["骑车","跳舞","吹口哨","看看世界","感受青春","知道自己是自由的"],"background_student":"有人给她送来食物、衣物和书报。她仍然无法自由走出藏身处。"},"bubbles":[{"id":"yamen","name":"亚门","title":"回到学校","image":"assets/yamen.webp","student_text":"母亲在家教亚门读书。他仍想回到学校；学习之外，他还要取水、捡柴。"},{"id":"varvara","name":"瓦尔瓦拉","title":"有光的夜晚","image":"assets/varvara.webp","student_text":"瓦尔瓦拉借烛光读书。停电也带来寒冷，她害怕没有灯光的夜晚。"}],"games":[{"title":"补回失踪的词","card":"挨打后，阿廖沙变得更敏感了。","prompt":"补一个不可丢失的感受。"},{"title":"剪断不成立的箭头","steps":["我受过欺辱","我后来熬出了头","亲人打孩子就是教育"],"prompt":"哪一条箭头，需要重新检验？"},{"title":"把赞美写准确","card":"小茨冈受伤了。","prompt":"我赞美他________，因为________。"}]};window.LESSON_NARRATION=[{"id":"cover","teacher":"同学们，请把《童年》、阅读本和笔放在手边。今天，我们会回到阿廖沙的生活，也会遇见另外几位孩子。请带着自己的判断来，也准备让新的文字改变这个判断。","action":"课前停在封面，检查投影边缘与文字大小。学生就绪后按右方向键或空格进入校园小路，开始计时。","hold":"课前准备，不占40分钟。画面可以停留；不提前展示三个问题的结论。","optional":"若有学生未读完：今天共同读到的片段也能成为证据，不必等读完整本书才参与。","timing":"课前"},{"id":"today","teacher":"放学了。书包随着脚步轻轻晃动，小路尽头有朋友在等。有人追着球跑，有人停下来看看树影。有些快乐很小，小到一天过去，我们都没有特意记住它。","action":"小人沿校园小路行走，镜头保持缓慢跟随的感觉；先看见小路和树影，再看见远处的同伴。行走约16秒后停步，不循环播放。","hold":"18秒，旁白与跟行同步。教师不征集学生故事，不增加分享活动。","optional":"若开场已超时，可删去“有些快乐很小”后的句子，保留行走和遇见同伴。","timing":"0:00—0:18"},{"id":"ordinary","teacher":"回到书桌前，也会有不会做的题，没说出口的委屈。快乐是真的，烦恼也是真的。它们都属于我们的童年。","action":"小人从小路进入书桌旁，坐下看作业，手停在纸上，肩膀稍微放低。桌面暖光保留，远处校园色彩渐淡。","hold":"12秒。让画面短暂停在“想继续写，却又停住”的姿态，不请学生解释自己的私人烦恼。","optional":"可以把“不会做的题”换成班级熟悉但不指向某个学生的普通情境；不借此评价谁的困难更值得难过。","timing":"0:18—0:30"},{"id":"window","teacher":"现在，跟着这个孩子推开窗。窗外不只是远方，还有一个男孩留下来的童年。","action":"小人站起走到窗前，两扇窗向外打开。镜头沿窗框中线向前推，前景窗框掠过两侧，现代街景退远，旧木屋进入视野。视角变化约6秒，之后停稳。","hold":"10秒，配合推窗说完。窗开后留约2秒让学生看清空间改变。","optional":"如果设备动作不顺，按下一步直接落到旧木屋；不重放多次打断开场。","timing":"0:30—0:40"},{"id":"arrival","teacher":"我们来到阿廖沙的世界。请翻开这本《童年》。","action":"旧木屋里，书封升起并停稳。下一步出现初判问题，再进入两段并读时才翻书。不能同时提前显示阅读结论。","hold":"5秒；书封升起后停住，给下一幕的初判留出空间。","optional":"","timing":"0:40—0:45"},{"id":"initial","teacher":"苦难和温暖，哪一个对阿廖沙的影响更大？请写下暂时的判断和理由，暂时不能比较也可以。说清你比较的是哪一方面。\n谁愿意用一句话说说？","action":"保持主问题和初判句式可见。学生书写时不点击答案，不做投票。收一位学生回答后，在1:50前后读出下一屏的默读指令，再进入两段并读。","hold":"0:45—1:00说明；1:00—1:35独立写35秒；1:35—1:50一人回答约15秒；1:50—2:00预告并读。初判留在阅读本，之后直接圈改。","optional":"学生只说“苦难多”：你比较的是出现次数，还是它给人留下的影响？先把这个角度记下来，待会儿回来检验。","timing":"0:45—2:00"},{"id":"parallel","teacher":"请独立读两段，圈出变化和感受；也找一找，让你犹豫的词。","action":"这句指令在上一状态1:50—2:00说完。2:00进入展开的双页并启动两分钟计时。左右两段完整可读，背景人物动作停住，教师不提前点亮关键词。","hold":"2:00—4:00完整保留两分钟独立阅读与圈画。教师保持安静，不逐句带读、不插入补讲。","optional":"个别学生找不到入口时，走近轻声提示：左边找受伤以后的感受，右边找外祖母带来的力量。不要面向全班中断默读。","timing":"2:00—4:00"},{"id":"compare","teacher":"先看受伤以后的这颗心。谁愿意读出支撑自己判断的几个字，再说说：阿廖沙发生了什么变化？\n你说这种影响很大。这里的“大”，是伤害很深、记得很久，还是改变了他看待别人的方式？请把你的比较角度说清楚。其他同学也看看，同一段里有没有补充这个判断、或者让它需要修改的文字。\n读到“长得很快”，我们很容易把它听成一句好话。可作者紧接着写出的，是“不安”，是心上的外皮仿佛被撕掉，是“难以忍受”。同一个变化里，可能有看见别人痛苦的能力，也有自己承受不了的痛。我们概括时，两边都要留下。\n再看外祖母。请把她的爱、阿廖沙获得的力量，和后面的“应付困苦的生活”连起来读。她给他的东西，怎样进入了他的生活？\n她没有替阿廖沙走完以后的生活，但让他知道，有一个人理解他、珍惜他。请注意句子的终点：“应付困苦的生活”。困难还在那里，力量也成为他的真实经验。\n现在把两段放在一起。对别人的痛苦更加敏感，和得到面对困苦的力量，作用相同吗？你可以坚持原来的选择，也可以说：如果看这一方面，我更看重这一种影响；但另一段又让我看见了什么。\n先把大家找到的文字并排留下。苦难留下真实的伤害，温暖也给了他真实的支持。我们还需要把“影响很深”和“这件事值得赞美”分开检验。接下来，再看一个曾经受过苦的人。","action":"左右原文持续显示。根据学生实际发言点击对应词句标记；没有被学生说到的词不提前全部亮起。比较视图只并列证据，不用天平、分数或胜负动画。最后一次点击让旧书页转向画作。","hold":"共6分钟。依次围绕受伤感受、外祖母的力量和两段联系收3—4个回答，每人30—40秒；教师按段讲述和承接约2分20秒，其余时间供回读、圈画与停顿。不要把每一问都重复问给每个人。","optional":"若只说“挨打让他善良”：你读到了体会别人痛苦的可能，这有文字依据。请把“不安”和“难以忍受”也放进解释，看看这句话怎样才能说完整。\n若坚持苦难影响更大：可以保留。请说明比较角度；影响很大与是否值得赞美，是接下来需要分别回答的事。\n若说“没有苦难就不会成为高尔基”：我们知道发生过什么，却不能仅凭这些确定另一种童年会怎样。先分清原文能证明什么。","timing":"4:00—10:00"},{"id":"haulers","teacher":"请看画中人的肩背，还有绷紧的纤绳。你看见了一个怎样的细节？\n这是列宾的《伏尔加河上的纤夫》。它帮助我们理解沉重的劳动；画中人并不是阿廖沙的外祖父。现在，把目光接回他的讲述。","action":"先完整显示原画，再缓慢放大肩背与纤绳区域，约5秒后停稳。教师可以回到全图。不得改变画中人物动作，也不把某一位纤夫标成外祖父。","hold":"40秒以内：约12秒观察，1人用约8秒指出可见细节，其余时间教师说明与转场。不展开美术赏析。","optional":"若学生说“他们很痛苦”：请指向一个你确实看到的姿态或细节，再说明你的感受。","timing":"10:00—10:40"},{"id":"grandfather","teacher":"请读外祖父的话，分别找出两种文字：他受过怎样的苦，他又怎样解释打孩子。\n先各报一处证据。也请留意“太过分了”这句话。他能够回想自己的痛，也有自省和亲近孩子的一面；可是，他随后又怎样给打孩子找理由？","action":"画作缩回，原文成为主要阅读面。教师根据学生回答分别标出“经历”和“解释”，同时保留“我当时对你太过分了”。不把两类文字自动连成成立的因果。","hold":"110秒：默读并画线60秒，两位学生各报一处短证据共约20秒，其余30秒用于指令、承接和静候。","optional":"若学生只说外祖父坏：先别用一个词收住他。请同时看见他的经历、他的自省，以及他仍然认可的打人理由。理解这些，不等于认可伤害。","timing":"10:40—12:30"},{"id":"turnone","teacher":"如果受过苦，就一定更懂得善待别人，为什么外祖父记得自己的痛，却仍把同样的痛给了孩子？\n我们可以理解他的经历，还要检验：这些经历，能不能成为伤害孩子的理由？","action":"两类文字退到背景，关键问句稳定浮现。镜头停住，保留可回看的原文入口。不要接着播放预设答案。","hold":"30秒。第一句说完静候5—8秒，不立即点名；第二句说完转入游戏。自然出现的短答可以承接一句，不追加一轮讨论。","optional":"","timing":"12:30—13:00"},{"id":"rules","teacher":"现在，我们一起修复三张阅读卡。有的卡漏了重要内容，有的把话说过了。先限时看屏，隐去后记下一点，再回原文核对。每人独立完成补词、断箭头和写表扬；听到新证据，可以继续修改。记不住不扣分，修法也不必相同。卡片由老师拟写，都要接受原文的检验。三张都站得住，我们一起完成挑战。","action":"三张卡依次出现，但只显示任务名，不显示后两关答案。讲完规则后进入第一关；全班留在原座位。教师资料中保留“教师拟写、待检验、非原著引文”的身份说明。","hold":"40秒。学生在阅读本准备三个短栏。各关默认收两种证据；如果有效证据已足够，立即推进，不为凑数量拖延。","optional":"如果学生问是否比赛：比的是能否发现遗漏、用文字修正；全班共同完成，不按速度、记忆力或立场排名。","timing":"13:00—13:40"},{"id":"r1read","teacher":"","action":"显示受伤后感受的完整目标片段，启动20秒阅读计时。卡一概括暂不抢占阅读区域。","hold":"20秒独立阅读，教师静候。结束后按下一步隐去原文。","optional":"","timing":"13:40—14:00"},{"id":"r1recall","teacher":"记下你最想保留的一个词。","action":"原文被纸页轻轻遮住，保持稳定留白，只留简短记录提示。","hold":"20秒写一词。口令可接在上一屏结束时说出；不反复催促，不判断学生记住了哪一类词。","optional":"","timing":"14:00—14:20"},{"id":"r1repair","teacher":"请回到原文核对。卡片说阿廖沙变得敏感了；这句话说出了变化，却还没有说完整。请补一个不能丢掉的感受。\n谁用一个词和一条理由解释自己的修订？再听一处不同的证据。\n现在，这种敏感带着怎样的代价，我们也看见了。请把补语留在自己的卡上。","action":"重新显示原文并持续保留。学生报出词语后，教师点击相应词语划线；在补语输入处写学生的实际表述。允许取消划线、修改补语，不自动填入标准答案。","hold":"110秒：30秒核对，约25秒独立补写，两人各约15秒说明；其余约25秒用于提问和归拢。","optional":"可追问：你补的短语怎样接住了“不安”“撕掉”或“难以忍受”？\n如果只留下“长得很快”：这个变化可以保留；同一段还有什么感受不能被它遮住？","timing":"14:20—16:10"},{"id":"r2read","teacher":"","action":"第二关显示外祖父受辱、熬出头及解释殴打的相关原句。启动20秒计时，因果线暂不显示。","hold":"20秒独立重读，教师静候。","optional":"","timing":"16:10—16:30"},{"id":"r2recall","teacher":"记下他的一条解释。","action":"原文隐去，留下记录提示。不要在此时透露哪一条箭头要剪断。","hold":"约8秒，写最短的关键词或短语即可，不要求完整抄句。","optional":"","timing":"16:30—16:38"},{"id":"r2repair","teacher":"原文回来了。请把外祖父的经历和这条因果线对照：前面的事，足以证明后面的判断吗？划断你认为不能成立的箭头，再写一个理由。\n请两位同学分别指出文字和理由。别人划的地方与你不同，也先听他怎样解释。\n他受过苦、后来熬出头，是经历。先后发生的事，不能就这样成为因果；后来取得的成绩，也不能替打孩子提供理由。","action":"显示三节点因果线与原文。依据学生回答点击箭头，使其断开；再次点击可恢复。节点保持原位，不能因箭头断开而抹掉经历。理由输入框记录学生实际表达，至少检验最后一条箭头。","hold":"122秒：约30秒核对，约25秒划线写理由，两人共约30秒说明，教师讲述和停顿合计约37秒。","optional":"若学生质疑第一条：你在检查“熬出头是否由受辱造成”，这个问题可以保留，请说明证据。\n若认为受过苦就有权打孩子：请把外祖父的经历和病床上孩子的感受都读出来，再检查这种权利是从哪一步得出的。","timing":"16:38—18:40"},{"id":"r3read","teacher":"","action":"显示小茨冈挡打、少挨几下与“为了爱”的上半段。后文保持未揭示状态。启动30秒计时。","hold":"30秒默读，教师静候。请学生通过屏幕提示关注动作、保护对象和目的。","optional":"","timing":"18:40—19:10"},{"id":"r3recall","teacher":"记下一个动作。","action":"上半段隐去，保留动作记录提示。","hold":"10秒，学生写一个动作词；不要求长句。","optional":"","timing":"19:10—19:20"},{"id":"r3repair","teacher":"“小茨冈受伤了”，写出了结果，却还没有说清值得赞美的是什么。请回到原文，圈出他的动作与目的，再写：我赞美他什么，因为哪一句文字让我看见了什么。\n请两位同学分别从行动和心意说证据。听完以后，再看自己的赞美是否落到了具体的人和事上。\n他的痛，是他承担的代价。让我们敬重的，是他为了另一个孩子主动伸出的胳膊。苦难中发生了善良，我们把赞美交给作出选择的人。","action":"原文再现。先让学生完成修订；根据其证据，再点亮“挡着”“少挨了几下”“为了爱”等相应词语。小茨冈保持挡在孩子身前的保护姿态，暖光只照亮两人的联系，环境阴影仍然存在。","hold":"140秒：约25秒回读，约35秒写赞美，两位学生各约20秒，教师提问与归拢约40秒。下一步之前，后半问答仍不出现。","optional":"若只写“他很伟大”：伟大落在哪一个动作上？这个动作给阿廖沙带来了什么？\n若把受伤本身当作奖章：伤痛是代价，值得赞美的选择是什么？请把动作和目的连起来。","timing":"19:20—21:40"},{"id":"again","teacher":"还有一段话。阿廖沙问：“还会打我吗？”","action":"第三张卡完成后先停住，暖光不熄灭。书页下部展开，先露出“下次再打你”与孩子的问句；回答仍未出现。","hold":"20秒。让学生默读问句，停顿约8秒；此处不抢着征求答案。","optional":"","timing":"21:40—22:00"},{"id":"againanswer","teacher":"小茨冈平平静静地回答：“当然要打啦！”请把这句回答读完。\n有人替他挡过一次，是否等于他以后就安全了？\n少挨了几下，知道自己被爱，这些帮助都真实存在。可是，下一次伤害还可能发生。我们把保护的可贵和未停止的伤害一起留在心里，再去读另一位孩子的愿望。","action":"教师推进后才显示小茨冈的回答。保护者与暖光留在边缘，远处阴影不消失。让学生并读孩子的疑问与这句回答。","hold":"60秒：约15秒看清回答并回读问句，收一个约10秒短答，余下时间用于讲述与转向安妮；不另组织讨论。","optional":"若说帮助没用：请先看“少挨了几下”。有价值与能解决全部问题，是两个不同的判断。","timing":"22:00—23:00"},{"id":"annecontext","teacher":"这位少女叫安妮·弗兰克。第二次世界大战期间，纳粹迫害犹太人。为了躲避迫害，她和家人在荷兰阿姆斯特丹藏匿起来。窗外仍有街道和日常生活，可对藏身的人来说，走出去意味着危险。请先记住这个处境，再读她的文字。","action":"显示手绘藏身空间与中央背景文字，窄窗留在背景。此幕没有安妮人物动画，教师用讲述交代人物与历史处境。","hold":"35秒，背景与人物关系一次交代清楚；不增加战争历史问答，不补述遇害结局。","optional":"若学生询问后来发生什么：今天先把目光放在这段日记写下的生活与愿望，课后可以继续了解她的完整经历。","timing":"23:00—23:35"},{"id":"annehelp","teacher":"他们并不孤立无援。帮助者把食物、衣物和书报送进来，让生活能够继续。这些人冒着风险关心他们，善意有了具体的重量。可是，送进房间的帮助，还不能让迫害停止。","action":"“食物”“衣物”“书报”三张文字纸签依次落定，动作总长不超过6秒。纸签代表实际帮助，画面不展示实物递送动画；窄窗仍在背景。","hold":"25秒。承认帮助的实际价值，再进入愿望；不把帮助者设成已经解决一切的英雄。","optional":"","timing":"23:35—24:00"},{"id":"annewish","teacher":"1943年12月24日，安妮写下这些愿望。请安静读一读，她渴望做哪些普通的事？\n请一位同学读给大家听。其他同学圈出其中一项，你平时也可能做的事。\n再请两位同学各指出一项。先说文字，不急着判断她是不是幸福。\n我们刚刚看见的那些活动，现在只映在玻璃上。对安妮来说，它们还没有成为能够走进去的生活。请把这些普通愿望，和我们刚才知道的处境放在一起。","action":"日记文字稳定显示。骑车、跳舞、吹口哨等以玻璃上的轻淡剪影出现；安妮仍在室内，不真的跨出窗。读文时动画停止，教师按学生指认突出相应愿望。","hold":"110秒：静读约20秒，一人朗读约15秒，两人各用约12秒指认，教师讲述及停顿合计约50秒。","optional":"如果学生说这些太普通：正因为普通，才请再想它需要什么条件，才能从纸上的愿望变成一天中的事情。\n若学生提到自己的烦恼：我们的困难也值得被听见；这里是在理解她为什么不能得到这些日常。","timing":"24:00—25:50"},{"id":"annetwist","teacher":"有人爱她，也有人帮助她，为什么她连骑车、吹口哨，都只能写成愿望？\n现在，把小茨冈的保护与安妮的愿望放在一起。幸福的童年，最不能缺少什么？请小组先说孩子已经得到什么，再说仍缺什么，用《童年》和安妮材料各一处证据，形成一项主张。选一项优先论证，不表示别的需要就可以取消。两人分别查两份证据，一人质疑，一人记录并发言，五分钟后交流。","action":"愿望剪影退到玻璃边，关键问句出现。教师停顿并口述任务、分工；小组任务和表达支架在下一幕证据总览才显示。进入下一幕后再开始五分钟计时。","hold":"70秒：第一问后静候5—8秒；其余用于任务说明、看清分工和前后相邻座位转向，不在此处先展开讨论。","optional":"并读的是孩子受到的支持及还需要的条件。阿廖沙的家庭暴力与安妮遭遇的纳粹迫害，成因并不相同。","timing":"25:50—27:00"},{"id":"group","teacher":"","action":"27:00进入证据总览，启动五分钟计时。两份来源的证据与表达支架保持可读，点击可放大当前片段并返回总览。学生无需操作设备；教师巡视。","hold":"完整5分钟。第1分钟人人说一句；第2—3分钟找《童年》与安妮各一据并解释；第4分钟质疑者问“这样就足够了吗”；第5分钟写约80字主张。教师不面向全班插讲。","optional":"只写“爱”：你们说的爱，具体怎样对待孩子？安妮已经得到的帮助，与她仍然想拥有的生活，有什么差别？\n只写“和平”：把这个词还原成孩子一天能做的具体事情。\n意见不同：可以保留“我们更重视……也有成员提醒……”，不必为了统一丢掉有证据的判断。","timing":"27:00—32:00"},{"id":"share","teacher":"请这一组先说最想守住的是什么，再分别指向两份材料。其他同学听一听：这个判断，能不能回应两个孩子的处境？\n请第二组说说你们的不同发现。\n现在请把抽象的词还原成孩子的一天：安全，是免于怎样的伤害；自由，是能做什么；尊重，又怎样发生在与人相处的时候？\n已有的支持值得珍惜，还有些生活条件需要更多人共同保障。把补充的证据写回主张。接下来请默读作者的回望，圈出一个能看见他愿望的词。","action":"显示两组主张的空白记录区。教师输入学生实际提出的条件与简短证据，不自动填入“安全”“爱”等预设答案。关键词可以随发言修改；不按立场打分。","hold":"3分钟。两组各约45秒，共90秒；约40秒供其他学生补证与圈改；教师追问、承接、转场约50秒。只选两组，不逐组重复汇报。","optional":"追问每组最多一次：这个词在孩子生活里是什么样？或哪句证据最能支持它？\n若学生说物质条件最重要：请指认什么需要不能仅靠安慰满足，再看实际帮助与尊重怎样共同发挥作用。","timing":"32:00—35:00"},{"id":"author","teacher":"谁用一个词说说？\n请用新证据修改初判。","action":"默读指令已在上一屏讲完。中央书页呈现作者回望，按独立片段排版。先保持未经强调的文字，35:40左右请一人用词解释“为什么值得写”；回答后再突出相应词。最后一句在35:56前后说完，进入修订后不再重复指令。","hold":"60秒：读文40秒；一人约14秒回答；教师短指令与承接合计约6秒。阅读中不做压扁人物的动画。","optional":"若学生把“值得写”理解成“伤害是好事”：请连着看“了解”和“连根儿拔掉”，作者希望这些处境怎样改变？\n若只看见希望：也请看见“压扁”的伤害，两个方面都在这段回望里。","timing":"35:00—36:00"},{"id":"revise","teacher":"","action":"回到开头问题，显示“我保留……我补充或修改……依据是……”。画面保持稳定，不弹出教师结论。","hold":"30秒完整用于个人圈改初判。允许改立场，也允许保留立场、把比较角度和理由说得更准确。教师静候。","optional":"","timing":"36:00—36:30"},{"id":"bubbles","teacher":"让这扇窗再打开一点，看看今天的孩子。","action":"小人走进房间，两只透明泡泡里已经可见真实资料照片。教师点击亚门的泡泡，进入第一份资料。","hold":"5秒，教师讲述同时发生；这是结语中的展陈，不新设学生任务。","optional":"","timing":"36:30—36:35"},{"id":"yamen","teacher":"2024年9月10日的报道里，亚门的妈妈尽力教他功课。可他还要取水、拾柴，仍需要学校和同伴。","action":"第一只泡泡展开为亚门的真实资料画面，图像保持纪实原貌。教师讲述时不叠加虚构年龄或人物对白。看清后按下一步进入瓦尔瓦拉。","hold":"15秒。只讲一个明确区别：家人的支持确实存在，学校与同伴仍然重要。屏幕不增加资料问答。","optional":"该报道发表于2024年9月10日，不能当作今天的实时状况。来源未提供可靠年龄，不能补写年龄。","timing":"36:35—36:50"},{"id":"varvara","teacher":"2022年12月19日的报道里，七岁的瓦尔瓦拉在烛光下读书。停电、寒冷，让安稳睡觉也变得困难。","action":"瓦尔瓦拉的文字居中呈现，母女照片在上方辅助识别人。照片本身不是烛光场景；烛光阅读、停电与寒冷来自报道文字，教师结合正文讲述。","hold":"15秒。“七岁”指报道当时的年龄；不当作她现在的年龄，也不虚构她说过的话。","optional":"把“灯亮着的夜晚”解释为本课对生活条件的概括，不给它加引号冒充儿童原话。","timing":"36:50—37:05"},{"id":"pressure","teacher":"房间一点点变窄，压着孩子的是什么？是战争、失学和恐惧，是需要成年人和社会共同改变的处境。有人爱他们，这些压力却依然存在。孩子不必先学会承受一切，才配拥有平静的一天。","action":"泡泡中的图像保留，逐渐退到边缘。灰影向室内逼近，木梁和边界压缩可活动的空间，小人收肩、停步。动作约6秒后停住，压力来自处境，不是把儿童照片砸到小人身上。","hold":"25秒，问句为教师讲述中的追问，不等待举手作答。说完后保留短暂静止，进入日常连接。","optional":"若学生明显难受，可提前进入桌前画面；用一句“这些处境需要被改变，孩子也需要被支持”承接，不扩展刺激性事实。","timing":"37:05—37:30"},{"id":"daily","teacher":"把目光带回身边。一个人被误解时，有人肯听他说完；遇到困难时，能找到可信赖的大人。你最想守住的条件，也应当落在这样的日常里。请独立写三句话：你的判断，一处《童年》的证据，以及它在生活中怎样体现。六十到九十字，按自己的理解写。","action":"显示桌前画面、两个日常例子与联系生活的提问。退出卡三个句式在下一幕才出现；教师可以在本幕先口述写作指令，并在38:00前讲完。","hold":"30秒，只作日常连接与写作说明，不再征集口头例子。","optional":"可使用学校、家里或虚构的小情境，不要求学生讲述私人创伤。行动落在尊重、倾听与求助，不要求儿童承担解决战争的责任。","timing":"37:30—38:00"},{"id":"exit","teacher":"","action":"保持三句话提示与静止书桌。启动90秒计时；人物、泡泡、灰影与纸页均停止运动。教师不重播动画，不打开资料面板。","hold":"38:00—39:30完整90秒独立书写。教师保持安静，不补讲、不要求临时展示。学生写完可自行检查：判断、原著证据、日常体现是否都有。","optional":"","timing":"38:00—39:30"},{"id":"support","teacher":"这些重量，需要成年人和社会一起承担，为孩子撑开生活的空间。","action":"确认90秒书写结束后推进。成年人双手进入画面，共同支撑木梁；房间只缓缓恢复一点空间，边缘仍留阴影。动作约6秒，不把所有困难瞬间消除。","hold":"8秒，旁白与支撑动作同步。学生不需要继续写或回答。","optional":"","timing":"39:30—39:38"},{"id":"ending","teacher":"伸来的手，接住了快落下的铅笔。愿每个孩子的普通愿望，都有机会成为普通的生活。","action":"镜头回到最初的书桌，一支将滑落的铅笔被一只手接住。小人仍在桌前，窗外留有明暗交接的远景。原结语出现后停住。","hold":"14秒。最后一句缓慢说完，保留约2秒安静，不追加道德训诫或新的任务。","optional":"","timing":"39:38—39:52"},{"id":"homework","teacher":"课后再找一处文字，支持或挑战今天的判断，写下一条批注。","action":"显示原课后任务：回读一处支持或挑战退出卡判断的原文，写约100—150字批注；未读完者继续原阅读计划。画面可在下课后继续停留。","hold":"8秒，不在最后赶着口述全部作业。学生可课后查看；不挤占退出卡。","optional":"","timing":"39:52—40:00"}];window.LESSON_SOURCES={"display_policy":{"student_view":"No material IDs, footnotes, source labels, editorial omission marks or reporting dates. Keep non-contiguous excerpts in visibly separate blocks.","teacher_view":"Preserve author, translator, PDF page numbers, historical dates and the distinction between quotation and paraphrase.","quotation_normalization":"Removed PDF line wraps and footnote numbers; normalized exclamation and question marks to fullwidth Chinese punctuation. Each novel excerpt was checked as one contiguous substring of the source, except that splitting a continuous excerpt into adjacent blocks is allowed.","critical_note":"The game cards are teacher-written summaries, not novel quotations. Teachers must say this aloud if the projected cards have no attribution label. The Anne sentence is a working Chinese translation of an excerpt, not a published Chinese translation."},"book":{"title":"童年","author":"马克西姆·高尔基","translator":"刘辽逸","publisher":"人民文学出版社","local_path":"/workspace/scratch/2815e6909237/project_sources/01-1-.pdf","page_count":281,"page_number_system":"PDF文件页序，非纸本页码","materials":{"A":{"pdf_pages":[34],"chapter":2},"B":{"pdf_pages":[18],"chapter":1},"C":{"pdf_pages":[36],"chapter":2},"D":{"pdf_pages":[38],"chapter":2},"E":{"pdf_pages":[243,244],"chapter":12}},"verification_date":"2026-10-23","teacher_context":{"A":"给桌布染色后受打、失去知觉并生病的回忆；读出变化与代价，不能省略伤害背景。","B":"成年叙述者回望外祖母的影响。","C":"外祖父先承认过分，随后仍为殴打辩解；保留人物复杂性。不同blocks不是连续全文。","D":"前三块为小茨冈的话，后半段问答需在赞美具体行动之后才揭示。","E":"成年叙述者说明讲述丑事是为了了解并清除它们，同时保留善良与希望；与历史/现实儿童处境并读不代表各处境成因相同。"}},"haulers":{"title":"伏尔加河上的纤夫","artist":"伊利亚·列宾","date":"1870—1873","medium":"布面油画","collection":"俄罗斯博物馆","collection_number":"Ж-4056","source_page":"https://rusmuseumvrm.ru/data/collections/painting/19_20/zh_4056/?lang=en","image_url":"https://rusmuseumvrm.ru/data/collections/painting/19_20/zh_4056/2143_mainfoto_01.jpg","local_image":"assets/haulers.jpg","credit":"俄罗斯博物馆","teacher_note":"相关历史劳动处境的视觉参照。画中人不是阿廖沙的外祖父，画作不能证明小说事件。学生画面可不显示出处，教师口述或教师资料保留。"},"anne":{"source_title":"EXTRA Freedom","source_org":"Anne Frank House","source_url":"https://www.annefrank.org/media/filer_public/d9/b4/d9b451a0-5471-4789-8ead-ea417eebeecb/afvd_werkblad_vo_5_vrijheid-en.pdf","pdf_page":1,"diary_entry_date":"1943-12-24","translation_status":"据安妮之家引英文所作课堂工作译文；中文末尾句号为截取片段的显示处理，不代表完整日记原句。","helpers_source":"https://www.annefrank.org/en/anne-frank/main-characters/","teacher_background":"第二次世界大战期间，犹太女孩安妮·弗兰克为躲避纳粹迫害在荷兰阿姆斯特丹藏匿。1942—1944年，八名藏匿者依靠六位帮助者得到食物、衣物、书籍、杂志和报纸。这些帮助支持了生活，迫害仍使自由出行危险。不要加入原教案未使用的遇害结局。"},"yamen":{"source_title":"Hope amid the rubble – Restoring learning in the Gaza Strip","author":"Jane Courtney, UNICEF Education Manager","publisher":"UNICEF","source_url":"https://www.unicef.org/blog/hope-amid-rubble-restoring-learning-gaza-strip","published":"2024-09-10","person_name":"Yamen","age":"来源未提供，不补写","place":"加沙地带","image_url":"https://www.unicef.org/sites/default/files/styles/media_large_image/public/IMG_6939.JPEG.webp?itok=LJnhx41B","image_credit":"UNICEF 2024","image_caption":"Yamen and his father share their hopes for learning to return.","local_image":"assets/yamen.webp","text_status":"据历史报道改述，无引号，不冒充采访直译。","teacher_intro":"这是联合国儿童基金会2024年报道中的亚门。他的母亲是教师，在家教他，他仍希望回到学校，与同伴一起学习。"},"varvara":{"source_title":"As winter bites, needs intensify for families in Ukraine","publisher":"UNICEF","source_url":"https://www.unicef.org/ukraine/en/stories/needs-intensify-for-families-in-ukraine","published":"2022-12-19","person_name":"Varvara","age_at_reporting":7,"place":"乌克兰基辅地区布恰","image_url":"https://www.unicef.org/ukraine/sites/unicef.org.ukraine/files/styles/media_large_image/public/DSC08513.jpg.webp?itok=duHTzdea","image_credit":"UNICEF","image_caption":"7-year-old Varvara with her mother","local_image":"assets/varvara.webp","text_status":"据历史报道改述，无引号，不冒充采访直译。","teacher_intro":"这是联合国儿童基金会2022年冬天报道中的瓦尔瓦拉，当时七岁。母亲为她点蜡烛读书，战争造成的停电却让家中失去灯光和温暖。不要将照片与年龄说成2026年的即时近况。"},"media_use_note":"Photos remain documentary originals. Do not redraw the children, remove photographer credit from teacher resources, or imply the pictures were taken for this class. Artwork is presented as a reproduction, not modified into novel evidence."};</script>
<script>(function(){
'use strict';
const A=window.LESSON_ASSETS,S=window.LESSON_SCENES,M=window.LESSON_TEXT,N=window.LESSON_NARRATION,SOURCES=window.LESSON_SOURCES;
const stage=document.getElementById('stage'),scene=document.getElementById('scene'),background=document.getElementById('background'),shade=document.getElementById('shade'),panel=document.getElementById('panel'),panelBody=document.getElementById('panelBody'),panelTitle=document.getElementById('panelTitle'),controls=document.getElementById('controls');
const mem={marks:{},edits:{},cuts:{},complete:{},scale:'',daily:'',index:0};
let index=0,hideControls=0,toastTimer=0,soundEnabled=false,audioContext=null,sceneAnimation=null,timerInterval=null,timerRemaining=0,timerDefault=0,timerRunning=false;
const timerValues={initial:35,parallel:120,grandfather:60,r1read:20,r1recall:20,r1repair:30,r2read:20,r2recall:8,r2repair:30,r3read:30,r3recall:10,r3repair:35,annewish:20,group:300,author:40,revise:30,exit:90};
const sheetTransitions=new Set(['parallel','rules','r1read','r2read','r3read','annecontext','group','author','revise','daily','exit','homework']);
const keys={A:['不安','撕掉','难以忍受','自己的或别人的','敏感'],B:['无私的爱','丰富了我','坚强的力量','应付困苦的生活'],C:['太过分了','受教训','欺辱','熬出头了'],D:['挡着你','少挨了几下','为了爱'],E:['连根儿拔掉','压扁','善良','光明的、人道的生活']};
const initialHash=location.hash.replace('#','');if(S.some(s=>s.id===initialHash))index=S.findIndex(s=>s.id===initialHash);
try{const saved=JSON.parse(localStorage.getItem('childhood-reading-state-v1')||'null');if(saved&&typeof saved==='object'){['marks','edits','cuts','complete'].forEach(k=>{if(saved[k]&&typeof saved[k]==='object')mem[k]=saved[k]});}}catch(e){}
const safe=x=>String(x==null?'':x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const img=(name,cls,alt)=>'<img class="'+(cls||'')+'" src="'+A[name]+'" alt="'+safe(alt||'')+'" draggable="false">';
const hero=(pose,cls)=>'<div class="hero pose-'+pose+' '+(cls||'')+'" aria-hidden="true"></div>';
const p=t=>'<p class="fragment">'+t+'</p>';
function words(text,list){let re=new RegExp('('+list.slice().sort((a,b)=>b.length-a.length).map(x=>x.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('|')+')','g');return text.split(re).map(t=>list.includes(t)?'<button class="word'+(marked(t)?' marked':'')+'" data-word="'+safe(t)+'" aria-pressed="'+marked(t)+'">'+safe(t)+'</button>':safe(t)).join('');}
function marked(t){return !!(mem.marks[S[index].id]||{})[t];}
function fragments(arr,list){return arr.map(t=>p(list?words(t,list):safe(t))).join('');}
function editable(id,placeholder){return '<div class="editable" contenteditable="true" role="textbox" spellcheck="false" data-edit="'+id+'" aria-label="'+safe(placeholder)+'" data-placeholder="'+safe(placeholder)+'">'+safe(mem.edits[id]||'')+'</div>';}
function center(title,body,cls){return '<div class="paper center-paper '+(cls||'')+'"><h1 class="big-question">'+title+'</h1>'+(body||'')+'</div>';}
function question(title,hint){return '<div class="quiet-question"><h1>'+title+'</h1>'+(hint?'<div class="divider"></div><p class="hint">'+hint+'</p>':'')+'</div>';}
function setBg(name,dark){background.style.backgroundImage='url("'+A[name]+'")';background.style.transform='scale(1)';background.style.filter='none';shade.style.background=dark||'rgba(24,42,31,.1)';}
function save(){try{localStorage.setItem('childhood-reading-state-v1',JSON.stringify(mem));}catch(e){}}
function notify(t){const el=document.getElementById('toast');el.textContent=t;el.classList.add('visible');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('visible'),2000);}
function showControls(){controls.classList.add('show');clearTimeout(hideControls);hideControls=setTimeout(()=>controls.classList.remove('show'),2800);}
function beep(type){if(!soundEnabled)return;try{if(!audioContext)audioContext=new(window.AudioContext||window.webkitAudioContext)();audioContext.resume();const t=audioContext.currentTime;const g=audioContext.createGain();g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(type==='page'?.018:.03,t+.03);g.gain.exponentialRampToValueAtTime(.0001,t+.45);g.connect(audioContext.destination);const o=audioContext.createOscillator();o.type='sine';o.frequency.setValueAtTime(type==='page'?330:523.25,t);o.frequency.exponentialRampToValueAtTime(type==='page'?200:659.25,t+.4);o.connect(g);o.start(t);o.stop(t+.5);}catch(e){}}
function bookPair(compare){const a0='外祖父把我打得失去了知觉，接着我病了一场。';const a1=M.A.blocks[0];return '<div class="paper main-paper book-reading"><div class="quote-grid"><article class="quote-column"><h2>受伤之后</h2><p class="context-line">'+a0+'</p>'+fragments([a1,M.A.blocks[1]],compare?keys.A:null)+'</article><article class="quote-column"><h2>外祖母给予的力量</h2>'+fragments(M.B.blocks,compare?keys.B:null)+'</article></div>'+(compare?'<div class="reading-footer"><div class="scale-row"><button class="soft-button" data-scale="伤害有多深">伤害有多深</button><button class="soft-button" data-scale="怎样看待别人">怎样看待别人</button><button class="soft-button" data-scale="怎样面对生活">怎样面对生活</button></div></div>':'<div class="reading-footer">圈出变化与感受，也留意让你犹豫的词。</div>')+'</div>';}
function repair(title,source,card,field,placeholder,extra){const id=S[index].id;return '<div class="paper repair-layout '+(mem.complete[id]?'is-complete ':'')+(extra||'')+'"><span class="bookmark" aria-hidden="true"></span><h1>'+title+'</h1><div class="repair-source">'+source+'</div><div class="repair-target"><p class="card-sentence">'+card+'</p>'+editable(field,placeholder)+(extra?'<div class="warm-glow"></div><div class="protect-figure" aria-hidden="true"></div>':'')+'</div><div class="repair-bottom"><p class="hint">让修订回到具体的文字。</p><button class="done-button '+(mem.complete[id]?'completed':'')+'" data-complete="'+id+'">'+(mem.complete[id]?'已留下证据':'完成修复')+'</button></div></div>';}
function bike(){return '<svg viewBox="0 0 120 70"><g class="bike-wheel"><circle cx="25" cy="46" r="20"/><path d="M25 26v40M5 46h40"/></g><g class="bike-wheel"><circle cx="96" cy="46" r="20"/><path d="M96 26v40M76 46h40"/></g><path d="M25 46 47 17 64 46 25 46 43 11M64 46 86 17 47 17M82 10h12l4 36M38 10h14"/></svg>';}
function dance(){return '<svg viewBox="0 0 100 80"><circle cx="52" cy="13" r="7"/><path d="m48 22-9 20 20 8 9-13M43 29 23 20 15 9M46 28 70 23 84 11M51 49 31 65 18 64M57 49 69 69 86 71"/><path d="M9 46q-5-17 9-26M82 48q16-8 8-22" opacity=".4"/></svg>';}
function whistle(){return '<svg viewBox="0 0 120 75"><path d="M5 49q18-30 40-14t32-6 35-3M16 64q15-19 31-9t43-11M36 17q10-12 20-2t16-8"/></svg>';}
function evidenceButton(key,title,arr){return '<button class="evidence-bit" data-material="'+key+'"><h3>'+title+'</h3>'+arr.map(t=>'<p>'+safe(t)+'</p>').join('')+'</button>';}
function bubbleHTML(){return '<div class="bubble-room"><button class="bubble bubble-one" data-goto="yamen" aria-label="打开亚门的故事">'+img('yamen.webp','','亚门与父亲')+'<span>回到学校</span></button><button class="bubble bubble-two" data-goto="varvara" aria-label="打开瓦尔瓦拉的故事">'+img('varvara.webp','','瓦尔瓦拉与母亲')+'<span>灯亮着的夜晚</span></button><div class="bubble bubble-small"><span>普通的愿望</span></div>'+hero(4,'bubble-hero')+'</div>';}
function documentary(id){const b=M.bubbles.find(x=>x.id===id);return '<article class="paper documentary '+(id==='varvara'?'focus-right':'')+'"><div class="documentary-photo">'+img(id+'.webp','',id==='yamen'?'亚门和父亲':'瓦尔瓦拉和母亲')+'</div><div class="documentary-content"><h1>'+(id==='yamen'?'回到学校':'灯亮着的夜晚')+'</h1><p>'+safe(b.student_text)+'</p></div></article>';}
function pressureBubbles(){return '<div class="pressure-bubbles"><div class="bubble bubble-one">'+img('yamen.webp','','')+'</div><div class="bubble bubble-two">'+img('varvara.webp','','')+'</div></div>';}
function hands(){return '<svg class="support-hands" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true"><g stroke="#765f47" stroke-width="3"><path fill="#405f57" d="M-40 810 130 355 194 374 90 900H-40Z"/><path fill="#d5aa7a" d="m130 355 10-58c3-23 17-26 22-10l2 24 10-49c3-16 17-13 15 3l-3 52 13-41c5-15 18-10 14 5l-10 44 14-29c7-14 19-7 12 7l-19 50-16 21Z"/><path fill="#796b91" d="m1640 840-172-480-63 15 108 525h127Z"/><path fill="#b18165" d="m1468 360-12-60c-4-21-18-22-22-7l-1 24-13-45c-5-15-18-10-15 5l7 48-16-35c-7-14-19-7-13 8l14 37-16-24c-9-12-20-3-10 10l22 37 12 17Z"/><path fill="#a68a52" d="m423 900 69-531 68 3 11 528Z"/><path fill="#e1bf94" d="m492 369-3-47c-2-18 11-23 17-7l8 21 1-64c0-17 15-18 17-1l5 59 6-56c2-18 16-15 16 2v58l8-36c4-16 18-13 15 4l-12 58-10 12Z"/><path fill="#658b80" d="m1020 900 35-514 71-9 81 523Z"/><path fill="#d7a680" d="m1055 386-9-50c-4-19 8-24 15-8l12 22-2-61c0-18 15-19 17-2l7 57 5-65c2-18 16-16 16 2v61l8-39c4-17 18-13 16 4l-8 57-6 13Z"/></g></svg>';}
function catchHand(){return '<svg class="catch-hand" viewBox="0 0 350 240" aria-hidden="true"><path fill="#577268" stroke="#344e43" stroke-width="3" d="M350 105 170 94l-12 83 192 63Z"/><path fill="#dfb98d" stroke="#9b7657" stroke-width="3" d="m173 97-47-22-58-2c-19 0-25 11-8 15l40 9-57 2c-19 1-21 14-2 17l56 4-54 5c-17 2-17 15 1 16l59 1-36 7c-16 4-10 16 4 15l66-3 23 16Z"/></svg>';}
function render(id){switch(id){
case 'cover':setBg('modern-lane.png','linear-gradient(90deg,#112f386e,#253b2310 80%)');return '<div class="intro-title"><p>高尔基《童年》阅读课</p><div class="thin-line"></div><h1>童年里，<br>什么值得被留下</h1><button class="enter-button" data-command="next">走进童年 <span>→</span></button></div>'+hero(2,'cover-hero');
case 'today':setBg('modern-lane.png');return '<div class="intro-word">我们的童年</div>'+hero(0,'walking');
case 'ordinary':setBg('modern-room.png');return '<div class="memory-note">快乐是真的，<br>烦恼也是真的。</div>'+hero(6,'ending-hero')+'<div class="pencil-sketch" aria-hidden="true"></div>';
case 'window':setBg('modern-room.png');return '<div class="window-sequence"><div class="portal-world"></div><div class="window-doors"><div class="window-pane left"></div><div class="window-pane right"></div></div>'+hero(3,'window-hero')+'</div>';
case 'arrival':setBg('old-room.png');return '<div class="arrival-caption">阿廖沙的世界</div><div class="book-object"><span>童年</span></div>';
case 'initial':setBg('old-room.png','#15211f50');return center('<span class="question-line">苦难和温暖，</span><span class="question-line">哪一个对阿廖沙的影响更大？</span>','<div class="divider"></div><p>如果看他________，<br>我暂时认为________。</p><p class="hint">暂时不能比较，也请留下理由。</p>');
case 'parallel':setBg('old-room.png','#17302858');return bookPair(false);
case 'compare':setBg('old-room.png','#17302858');return bookPair(true);
case 'haulers':setBg('old-room.png','#162420a0');return '<div class="art-actions"><button data-art="whole">看全画</button><button data-art="shoulders">看肩背</button><button data-art="rope">看纤绳</button></div><div class="picture-crop">'+img('haulers.jpg','hauler-image','伏尔加河上的纤夫')+'</div><div class="art-caption">伏尔加河上的纤夫</div>';
case 'grandfather':setBg('old-room.png','#17302870');return '<div class="paper main-paper"><h1>另一个受过苦的人</h1><div class="grandfather-grid"><article><h2>他经历过什么？</h2>'+fragments([M.C.blocks[2],M.C.blocks[3],M.C.blocks[4]],keys.C)+'</article><article><h2>他怎样解释？</h2>'+fragments([M.C.blocks[0],M.C.blocks[1]],keys.C)+'<div class="divider"></div><p class="hint">他的经历，能证明他的解释吗？</p></article></div></div>';
case 'turnone':setBg('old-room.png','#0b22219c');return question('如果受过苦，<br>就<strong>一定</strong>更懂得善待别人，<br>为什么外祖父记得自己的痛，<br>却仍把同样的痛给了孩子？');
case 'rules':setBg('modern-room.png','#2e322961');return '<div class="paper main-paper"><h1>阅读卡修复挑战</h1><div class="rules-grid"><div class="rule-card"><span class="line-icon">补</span><h2>补回失踪的词</h2></div><div class="rule-card"><span class="line-icon">断</span><h2>检验一条箭头</h2></div><div class="rule-card"><span class="line-icon">赞</span><h2>把赞美写准确</h2></div></div><p class="rules-flow">读原文 → 暂时隐去 → 回看 → 修订</p><p class="hint" style="text-align:center">每人独立留下证据，全班共同完成。</p></div>';
case 'r1read':setBg('old-room.png','#182c265e');return '<div class="paper single-reading"><h1>补回失踪的词</h1>'+fragments([M.A.game_excerpt])+'</div>';
case 'r1recall':setBg('old-room.png','#182c265e');return '<div class="paper recall-paper"><h1>记下你最想保留的一个词。</h1><div class="recall-line"></div><p class="hint">稍后回到原文，还可以补充与修改。</p></div>';
case 'r1repair':setBg('old-room.png','#182c265e');return repair('让这句话更完整',fragments([M.A.game_excerpt],keys.A),'挨打后，阿廖沙变得更敏感了。','r1supplement','我补上……');
case 'r2read':setBg('old-room.png','#182c265e');return '<div class="paper main-paper"><h1>再读一读他的解释</h1>'+fragments(M.C.short_blocks)+'</div>';
case 'r2recall':setBg('old-room.png','#182c265e');return '<div class="paper recall-paper"><h1>记下他的一条解释。</h1><div class="recall-line"></div></div>';
case 'r2repair':setBg('old-room.png','#182c265e');return '<div class="paper repair-layout '+(mem.complete[id]?'is-complete':'')+'"><span class="bookmark"></span><h1>剪断不成立的箭头</h1><div class="repair-source r2-source-grid">'+fragments(M.C.short_blocks,keys.C)+'</div><div class="cause-line"><div class="cause-node">我受过欺辱</div><button class="cause-arrow '+(mem.cuts.one?'cut':'')+'" data-arrow="one" aria-label="检验第一条箭头" aria-pressed="'+!!mem.cuts.one+'">→</button><div class="cause-node">我后来<br>熬出了头</div><button class="cause-arrow '+(mem.cuts.two?'cut':'')+'" data-arrow="two" aria-label="检验第二条箭头" aria-pressed="'+!!mem.cuts.two+'">→</button><div class="cause-node">亲人打孩子<br>就是教育</div></div>'+editable('r2reason','这条联系不能成立，因为……')+'<div class="repair-bottom"><p class="hint">经历仍然在，联系需要检验。</p><button class="done-button '+(mem.complete[id]?'completed':'')+'" data-complete="'+id+'">'+(mem.complete[id]?'已留下证据':'完成修复')+'</button></div></div>';
case 'r3read':setBg('old-room.png','#182c265e');return '<div class="paper main-paper"><h1>读懂保护的动作</h1>'+fragments(M.D.blocks)+'<div class="reading-footer">他做了什么？为了谁？为了什么？</div></div>';
case 'r3recall':setBg('old-room.png','#182c265e');return '<div class="paper recall-paper"><h1>记下一个动作。</h1><div class="recall-line"></div></div>';
case 'r3repair':setBg('old-room.png','#182c265e');return repair('把赞美写准确',fragments(M.D.short_blocks,keys.D),'小茨冈受伤了。','r3praise','我赞美他……因为……','protect-layout');
case 'again':setBg('old-room.png','#102b2a72');return '<div class="continuing-protection" aria-hidden="true"></div><div class="continuing-glow" aria-hidden="true"></div><div class="paper dialogue-paper"><p class="fragment">“下次再打你，记住，你别抱紧身子缩作一团，你懂吗？”</p><div class="divider"></div><p class="dialogue"><small>阿廖沙问</small>“还会打我吗？”</p></div>';
case 'againanswer':setBg('old-room.png','#102b2a72');return '<div class="continuing-protection" aria-hidden="true"></div><div class="continuing-glow" aria-hidden="true"></div><div class="paper dialogue-paper"><p class="dialogue"><small>阿廖沙问</small>“还会打我吗？”</p><p class="dialogue"><small>小茨冈平平静静地说</small>“当然要打啦！”</p><div class="divider"></div><p class="hint">有人替他挡过一次，是否等于他以后就安全了？</p></div>';
case 'annecontext':setBg('anne-room.png','#1426384a');return '<div class="paper anne-context"><h1>安妮的藏身生活</h1><p>为了躲避纳粹对犹太人的迫害，<br>安妮和家人在阿姆斯特丹藏匿。</p><div class="divider"></div><p>窗外有街道，<br>走出去却意味着危险。</p></div>';
case 'annehelp':setBg('anne-room.png','#1426384a');return '<div class="paper anne-context"><h1>有人一直在帮助他们</h1><div class="help-items"><div class="help-item">食物</div><div class="help-item">衣物</div><div class="help-item">书报</div></div><p style="text-align:center">善意支持着生活，<br>她仍然无法自由走出去。</p></div>';
case 'annewish':setBg('anne-room.png','#1426384a');return '<div class="paper single-reading"><h1>她渴望的，是怎样的生活？</h1><p class="wish-text">'+words(M.anne.blocks[0],M.anne.wishes)+'</p><div class="wish-scenes"><div class="wish-picture" data-wish="骑车">'+bike()+'</div><div class="wish-picture" data-wish="跳舞">'+dance()+'</div><div class="wish-picture" data-wish="吹口哨">'+whistle()+'</div></div></div>';
case 'annetwist':setBg('anne-room.png','#0c243286');return question('有人爱她，也有人帮助她，<br>为什么她连骑车、吹口哨，<br>都只能写成愿望？','把已经得到的帮助，与仍然缺少的条件放在一起看。');
case 'group':setBg('modern-room.png','#23372c70');return '<div class="paper group-layout"><h1>幸福的童年，最不能缺少什么？</h1><div class="evidence-board"><div class="evidence-stack">'+evidenceButton('A','受伤之后',['“不安的心情”','“难以忍受的敏感”'])+evidenceButton('B','外祖母给予的力量',['“无私的爱丰富了我”','“坚强的力量以应付困苦的生活”'])+'</div><div class="evidence-stack">'+evidenceButton('C','外祖父的解释',['“我当时对你太过分了”','“挨自己亲人的打，这不算屈辱，是受教训”'])+evidenceButton('D','小茨冈的保护',['“少挨了几下”　“为了爱”','“还会打我吗？”“当然要打啦！”'])+'</div><div class="evidence-stack">'+evidenceButton('anne','安妮的愿望',['有人送来食物、衣物和书报，她仍无法自由出门。',M.anne.blocks[0]])+'</div></div><p class="group-prompt">我们认为最不能缺少________。<br>《童年》中________说明________；安妮的________说明________。<br>已有的善意值得珍惜，还需要________真正发生／不再发生。</p><p class="group-roles">两人分别查两份证据 · 一人质疑 · 一人记录并发言</p><div class="group-steps"><span>每人说一句</span><span>找两处证据</span><span>追问“足够了吗”</span><span>写约80字主张</span></div></div>';
case 'share':setBg('modern-room.png','#23372c70');return '<div class="paper main-paper"><h1>把一个条件，还原成孩子的一天</h1><div class="share-grid"><div class="share-card"><h2>这一组的主张</h2>'+editable('groupOne','最想守住的是……')+editable('evidenceOne','文字让我们看见……')+'</div><div class="share-card"><h2>另一组的发现</h2>'+editable('groupTwo','最想守住的是……')+editable('evidenceTwo','文字让我们看见……')+'</div></div><div class="daily-response" id="dailyResponse">'+editable('concreteLife','这个词，在孩子的生活里是……')+'</div></div>';
case 'author':setBg('old-room.png','#152b255f');return '<div class="paper main-paper"><h1>值得讲这些吗？</h1><div class="author-fragments"><article>'+fragments([M.E.blocks[1],M.E.blocks[2]],keys.E)+'</article><article>'+fragments([M.E.blocks[3]],keys.E)+'</article></div><p class="author-tail">'+words(M.E.blocks[4],keys.E)+'</p></div>';
case 'revise':setBg('old-room.png','#152b255f');return center('再看开头的判断','<div class="divider"></div><p>我保留________。<br>我补充或修改________。<br>依据是________。</p><p class="hint">可以改变立场，也可以把原来的理由说得更准确。</p>');
case 'bubbles':setBg('bubble-hall.png');return bubbleHTML();
case 'yamen':setBg('bubble-hall.png','#4d5e484b');return documentary('yamen');
case 'varvara':setBg('bubble-hall.png','#394e4f6b');return documentary('varvara');
case 'pressure':setBg('bubble-hall.png','#31444135');return '<div class="pressure-scene">'+pressureBubbles()+'<div class="pressure-shadow"></div><div class="beam descending-beam"></div><div class="pressure-words"><span>战争</span><span>课堂中断</span><span>恐惧</span></div>'+hero(5,'pressure-hero')+'<div class="pressure-question">什么正在压着孩子？</div></div>';
case 'daily':setBg('modern-room.png','#20393051');return center('把目光带回身边','<div class="divider"></div><p>被误解时，有人肯听他说完。<br>遇到困难时，能找到可信赖的大人。</p><p class="hint">你最想守住的条件，怎样成为一件日常的小事？</p>');
case 'exit':setBg('modern-room.png','#20393051');return '<div class="paper exit-paper"><h1>留下自己的三句话</h1><div class="exit-lines"><p class="exit-line">我认为，幸福童年最不能缺<span class="blank"></span>。</p><p class="exit-line">《童年》中<span class="blank"></span>，<br>让我看到<span class="blank"></span>。</p><p class="exit-line">在日常生活中，<br>它可以体现为<span class="blank"></span>。</p></div><p class="hint" style="text-align:center;margin-top:3vh">判断 · 原著证据 · 日常体现　　60—90字</p></div>';
case 'support':setBg('bubble-hall.png','#203b3b67');return '<div class="pressure-scene">'+pressureBubbles()+'<div class="pressure-shadow lifting-shadow"></div><div class="beam"></div>'+hands()+hero(7,'pressure-hero')+'<p class="support-caption">为孩子，撑开生活的空间。</p></div>';
case 'ending':setBg('modern-room.png','#14332623');return '<div class="ending-card"><h1>愿每个孩子的普通愿望，<br>都有机会成为普通的生活。</h1></div>'+hero(2,'ending-hero')+'<div class="pencil-sketch ending-pencil"></div>'+catchHand();
case 'homework':setBg('modern-room.png','#183d345a');return '<div class="paper homework-paper"><h1>把阅读继续下去</h1><p>再选一处支持或挑战今天判断的原文，<br>写一条100—150字的批注。</p><div class="divider"></div><p>这处文字使我保留／修改了________，<br>因为________。</p><p class="hint">未读完的同学，继续原来的阅读计划。</p></div>';
default:return '';
}}
function updateProtection(){if(S[index].id!=='r3repair')return;const el=scene.querySelector('.repair-layout');el.classList.toggle('has-protection',marked('挡着你')||marked('少挨了几下')||marked('为了爱'));el.classList.toggle('has-love',marked('为了爱'));}
function go(next,replay){if(next<0||next>=S.length)return;captureEdits();if(panel.open)panel.close();index=next;const id=S[index].id;mem.index=index;stage.className='scene-'+id;stage.dataset.scene=id;scene.innerHTML=render(id);stage.style.setProperty('--sprite','url("'+A['child-sprites.png']+'")');stage.style.setProperty('--protectors','url("'+A['protectors.png']+'")');stage.style.setProperty('--old-room','url("'+A['old-room.png']+'")');document.getElementById('progress').firstElementChild.style.width=(index/(S.length-1)*100)+'%';document.querySelector('[data-command="previous"]').disabled=index===0;document.querySelector('[data-command="next"]').disabled=index===S.length-1;try{history.replaceState(null,'','#'+id);}catch(e){}document.title='童年里，什么值得被留下 · '+S[index].title;
if(sceneAnimation)sceneAnimation.cancel();if(!document.body.classList.contains('reduce-motion'))sceneAnimation=scene.animate([{opacity:.12,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:650,easing:'cubic-bezier(.22,.65,.25,1)'});
const page=document.getElementById('pageTurn');page.classList.remove('page-turning');if(sheetTransitions.has(id)&&!replay){void page.offsetWidth;page.classList.add('page-turning');beep('page');}setTimer(timerValues[id]||0);updateProtection();if(id==='annewish')updateWishes();save();}
function captureEdits(){scene.querySelectorAll('[data-edit]').forEach(e=>mem.edits[e.dataset.edit]=e.innerText.trim());}
function updateWishes(){scene.querySelectorAll('[data-wish]').forEach(el=>el.classList.toggle('visible',marked(el.dataset.wish)));}
function setTimer(n){clearInterval(timerInterval);timerRunning=false;timerDefault=n;timerRemaining=n;const el=document.getElementById('timer');el.hidden=!n;el.classList.remove('finished');paintTimer();}
function paintTimer(){const m=Math.floor(timerRemaining/60),s=timerRemaining%60;document.getElementById('timerValue').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');document.getElementById('timerRing').style.strokeDashoffset=timerDefault?144.513*(1-timerRemaining/timerDefault):0;document.getElementById('timerToggle').setAttribute('aria-label',timerRunning?'暂停计时':'开始计时');}
function toggleTimer(){if(!timerDefault){notify('这一幕由你掌握停留时间');return;}if(timerRunning){clearInterval(timerInterval);timerRunning=false;paintTimer();return;}if(timerRemaining<=0)timerRemaining=timerDefault;timerRunning=true;document.getElementById('timer').classList.remove('finished');let last=Date.now();timerInterval=setInterval(()=>{const now=Date.now();if(now-last>=950){const secs=Math.max(1,Math.floor((now-last)/1000));last+=secs*1000;timerRemaining=Math.max(0,timerRemaining-secs);paintTimer();if(!timerRemaining){clearInterval(timerInterval);timerRunning=false;document.getElementById('timer').classList.add('finished');paintTimer();}}},200);paintTimer();}
function openPanel(title,html){captureEdits();save();panelTitle.textContent=title;panelBody.innerHTML=html;panel.showModal();panelBody.scrollTop=0;}
function menu(){openPanel('课堂目录','<div class="menu-actions"><button data-command="help">操作说明</button><button data-command="contrast">投影增强</button><button data-command="motion">切换简静动画</button><button data-command="sources">教师资料来源</button><button data-command="reset">清空本次课堂记录</button></div><div class="menu-grid">'+S.map((s,i)=>'<button data-jump="'+i+'" class="'+(i===index?'current':'')+'"><small>'+safe(s.time)+'</small>'+safe(s.title)+'</button>').join('')+'</div>');}
function notes(){const n=N.find(n=>n.id===S[index].id)||{};openPanel('教师讲稿 · '+S[index].title,'<p class="notes-meta">'+safe(S[index].time)+'　'+safe(S[index].id)+'</p><h3>这一段怎么说</h3><p class="teacher-speech">'+safe(n.teacher||'教师静候，把完整时间交给学生。')+'</p><h3>画面与操作</h3><p>'+safe(n.action||'')+'</p><h3>停留与课堂安排</h3><p>'+safe(n.hold||'')+'</p>'+(n.optional?'<h3>按需承接</h3><p class="teacher-speech">'+safe(n.optional)+'</p>':''));}
function help(){openPanel('课前操作说明','<h3>使用方式</h3><p>按 →、空格或 PageDown 推进下一幕；按 ← 或 PageUp 返回上一幕。每一幕都可以停留，材料不会自动翻走。</p><p>F：全屏　M：目录　N：教师讲稿　R：重播本幕　T：开始或暂停计时　Esc：关闭面板</p><p>移动鼠标到屏幕下方，可显示控制栏。计时归零只作提示；由教师决定何时推进。每次换幕，计时都会暂停并重置为该幕所需时间。</p><h3>课堂操作</h3><p>并读与修复时，点击学生指出的词语留下划线；再次点击可取消。断箭头关卡，两条箭头分别可断开和恢复。补语、理由、赞美句与小组主张可由教师填写，文字自动保存在本浏览器。</p><p>小组讨论时点击证据可放大，关闭后回到总览，计时继续。现实资料泡泡可以点击，也可以用翻页笔依次展开。</p><h3>投影与声音</h3><p>所有插画、照片、字体和讲稿已内嵌，可离线使用。声音默认关闭；控制栏 ♪ 可开启轻微翻页提示。投影较淡时，在目录中启用“投影增强”。“简静动画”会直接显示镜头结束状态。</p><p>教师讲稿、材料来源和本说明只用于备课查看，关闭面板即可回到学生画面。开始新班级前可在目录里清空课堂记录。</p>');}
function sourceHTML(obj){if(Array.isArray(obj))return '<ul class="note-list">'+obj.map(x=>'<li>'+sourceHTML(x)+'</li>').join('')+'</ul>';if(obj&&typeof obj==='object')return Object.entries(obj).map(([k,v])=>'<p><strong>'+safe(k)+'</strong></p>'+sourceHTML(v)).join('');const t=String(obj||'');return /^https?:\/\//.test(t)?'<p><a href="'+safe(t)+'" target="_blank" rel="noreferrer">'+safe(t)+'</a></p>':'<p>'+safe(t)+'</p>';}
function sourcePanel(){openPanel('教师资料来源与文本说明','<p>以下为教师备课资料，学生主画面不显示编号、删节标记与来源。原著的不连续选段采用独立段块呈现；游戏概括由教师拟写，须在规则讲解中说明。现实儿童材料来自有日期的历史报道。</p><div class="sources-list">'+sourceHTML(SOURCES)+'</div><h3>美术与字体</h3><p>场景、读者角色与保护者插画为本课原创生成的文学意象，并非历史现场照片。真实儿童照片保持其纪实身份。中文字体采用 Noto Sans CJK SC 与 Noto Serif CJK SC，依照 SIL Open Font License 嵌入子集。</p>');}
function material(key){const t=M[key];let content=t.blocks;if(key==='A')content=[t.context_excerpt,...t.blocks];if(key==='D')content=[...t.blocks,...t.next_time_blocks];openPanel(t.title,'<div class="evidence-modal">'+fragments(content)+'</div>');}
function full(){if(!document.fullscreenElement){document.documentElement.requestFullscreen().catch(()=>notify('请使用浏览器全屏键 F11'));}else document.exitFullscreen().catch(()=>{});}
function command(name){switch(name){case'next':go(index+1);break;case'previous':go(index-1);break;case'menu':menu();break;case'notes':notes();break;case'help':help();break;case'sources':sourcePanel();break;case'fullscreen':full();break;case'timer':toggleTimer();break;case'replay':go(index,true);break;case'sound':soundEnabled=!soundEnabled;document.querySelector('[data-command="sound"]').setAttribute('aria-pressed',soundEnabled);document.querySelector('[data-command="sound"]').setAttribute('aria-label',soundEnabled?'关闭音效':'开启音效');beep('done');notify(soundEnabled?'音效已开启':'音效已关闭');break;case'contrast':document.body.classList.toggle('high-contrast');notify(document.body.classList.contains('high-contrast')?'投影增强已开启':'已恢复柔和画面');break;case'motion':document.body.classList.toggle('reduce-motion');notify(document.body.classList.contains('reduce-motion')?'已切换简静动画':'已恢复完整动画');break;case'reset':openPanel('清空课堂记录','<p>将清空本浏览器中的划线、补语、箭头与小组记录，并回到封面。</p><div class="menu-actions"><button data-command="confirm-reset">清空并回到封面</button><button data-command="cancel-reset">保留记录</button></div>');break;case'confirm-reset':mem.marks={};mem.edits={};mem.cuts={};mem.complete={};save();scene.querySelectorAll('[data-edit]').forEach(e=>e.innerText='');go(0);break;case'cancel-reset':panel.close();break;}}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.command){command(b.dataset.command);return;}if(b.dataset.jump!==undefined){go(Number(b.dataset.jump));return;}if(b.dataset.goto){go(S.findIndex(s=>s.id===b.dataset.goto));return;}if(b.dataset.word){const k=S[index].id;mem.marks[k]=mem.marks[k]||{};mem.marks[k][b.dataset.word]=!mem.marks[k][b.dataset.word];b.classList.toggle('marked');b.setAttribute('aria-pressed',b.classList.contains('marked'));updateProtection();updateWishes();save();return;}if(b.dataset.arrow){mem.cuts[b.dataset.arrow]=!mem.cuts[b.dataset.arrow];b.classList.toggle('cut',mem.cuts[b.dataset.arrow]);b.setAttribute('aria-pressed',!!mem.cuts[b.dataset.arrow]);save();return;}if(b.dataset.complete){mem.complete[b.dataset.complete]=!mem.complete[b.dataset.complete];b.closest('.repair-layout').classList.toggle('is-complete',mem.complete[b.dataset.complete]);b.classList.toggle('completed',mem.complete[b.dataset.complete]);b.textContent=mem.complete[b.dataset.complete]?'已留下证据':'完成修复';beep('done');save();return;}if(b.dataset.scale){scene.querySelectorAll('[data-scale]').forEach(x=>x.classList.toggle('active',x===b));return;}if(b.dataset.art){const el=scene.querySelector('.hauler-image');el.style.transformOrigin=b.dataset.art==='rope'?'64% 53%':'27% 42%';el.style.transform=b.dataset.art==='whole'?'scale(1)':'scale(1.65)';return;}if(b.dataset.material){material(b.dataset.material);return;}if(b.dataset.daily){const responses={'安全':'不必担心下一次伤害，能安心睡下。','自由':'能正常出门，与伙伴相见。','尊重':'说话有人听，痛苦被认真对待。','学习':'有课堂、有同伴，也有继续学习的机会。'};scene.querySelectorAll('[data-daily]').forEach(x=>x.classList.toggle('active',x===b));const el=document.getElementById('dailyResponse');if(b.dataset.daily==='自填'){el.innerHTML=editable('otherCondition','这个条件在生活里是……');el.querySelector('[contenteditable]').focus();}else el.textContent=responses[b.dataset.daily];}});
document.addEventListener('input',e=>{if(e.target.matches('[data-edit]')){mem.edits[e.target.dataset.edit]=e.target.innerText.trim();save();}});
document.addEventListener('paste',e=>{if(e.target.isContentEditable){e.preventDefault();const text=(e.clipboardData||window.clipboardData).getData('text');document.execCommand('insertText',false,text);}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(panel.open)panel.close();return;}if(e.target.isContentEditable||e.target.matches('input,textarea,select'))return;if(panel.open){if(e.key.toLowerCase()==='m'){e.preventDefault();menu();}return;}const k=e.key.toLowerCase();if(['arrowright','pagedown',' '].includes(k)){e.preventDefault();command('next');}else if(['arrowleft','pageup'].includes(k)){e.preventDefault();command('previous');}else if(k==='f'){e.preventDefault();full();}else if(k==='m')menu();else if(k==='n')notes();else if(k==='r')go(index,true);else if(k==='t')toggleTimer();});
document.addEventListener('pointermove',e=>{if(e.clientY>innerHeight-130||e.pointerType==='touch')showControls();});document.addEventListener('touchstart',showControls,{passive:true});
document.getElementById('closePanel').addEventListener('click',()=>panel.close());panel.addEventListener('click',e=>{if(e.target===panel){const r=panel.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)panel.close();}});
document.getElementById('timerToggle').addEventListener('click',toggleTimer);document.getElementById('timerReset').addEventListener('click',()=>setTimer(timerDefault));
document.addEventListener('fullscreenchange',()=>{document.querySelector('[data-command="fullscreen"]').setAttribute('aria-label',document.fullscreenElement?'退出全屏':'进入全屏');});
window.addEventListener('beforeunload',()=>{captureEdits();save();});
if(matchMedia('(prefers-reduced-motion:reduce)').matches)document.body.classList.add('reduce-motion');
go(index);showControls();
})();
</script>
</body>
</html>
