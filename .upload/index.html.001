<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="light">
<title>童年里，什么值得被留下</title>
<style>@font-face{font-family:ClassroomSans;src:url('data:font/woff;base64,') format('woff');font-display:swap;font-weight:100 900}
@font-face{font-family:ClassroomSerif;src:url('data:font/woff;base64,') format('woff');font-display:swap;font-weight:100 900}
:root{--ink:#23362e;--soft:#657366;--paper:#fffaf0;--gold:#b18b43;--green:#557965;--serif:ClassroomSerif,'Noto Serif CJK SC','Songti SC',serif;--sans:ClassroomSans,'Microsoft YaHei','PingFang SC',sans-serif;--read:clamp(23px,2.12vw,39px);--title:clamp(32px,3.45vw,65px);--small:clamp(17px,1.4vw,27px)}
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#23332b;color:var(--ink);font-family:var(--sans)}button,input,textarea{font:inherit}button{cursor:pointer;touch-action:manipulation;color:inherit}button:focus-visible,[contenteditable]:focus-visible{outline:3px solid #c29341;outline-offset:5px}button{border:0}#stage{width:100%;height:100dvh;isolation:isolate;position:relative;overflow:hidden}#background{position:absolute;inset:-2%;background-size:cover;background-position:center;transition:background-image .3s,filter 1.1s,transform 1.4s;z-index:-4}#shade{position:absolute;inset:0;z-index:-3;background:rgba(20,35,30,.09);transition:background 1s}#grain{position:absolute;inset:0;z-index:11;pointer-events:none;opacity:.045;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' opacity='.5' filter='url(%23g)'/%3E%3C/svg%3E")}#scene{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:5vh 5vw 7vh;perspective:1400px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--serif);font-weight:600}h1{font-size:var(--title);line-height:1.5;letter-spacing:.035em}h2{font-size:clamp(27px,2.6vw,49px);line-height:1.45}h3{font-size:clamp(23px,1.95vw,37px);line-height:1.5}.paper{position:relative;background:rgba(255,251,241,.98);box-shadow:0 26px 85px #10221835,0 1px 1px #fff8 inset;border:1px solid #ebe1c9;border-radius:5px 20px 7px 23px;color:var(--ink)}.main-paper{width:min(91vw,1700px);max-height:86vh;padding:3.2vh 3.4vw;display:flex;flex-direction:column;gap:2.1vh}.main-paper>h1{text-align:center}.center-paper{width:min(87vw,1580px);padding:5.8vh 5vw;text-align:center}.center-paper p{font-size:var(--read);line-height:1.9;margin-top:2.5vh}.big-question{font-size:clamp(35px,4.05vw,76px);line-height:1.65}.question-line{display:block}.hint{font-size:var(--small);color:#607061;line-height:1.7;letter-spacing:.025em}.center-paper .hint{font-size:var(--small)}.divider{width:55px;height:2px;background:#c5ac76;margin:2.8vh auto}.fragment{font-size:var(--read);line-height:1.85;text-align:justify;text-justify:inter-ideograph}.fragment+.fragment{margin-top:1.3vh}.quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:4vw}.quote-column{position:relative;padding:0 1vw}.quote-column+ .quote-column{border-left:1px solid #d7cbb3;padding-left:3vw}.quote-column h2{font-size:clamp(24px,2.35vw,44px);margin-bottom:1.6vh}.quote-column .fragment{font-size:clamp(22px,1.95vw,37px);line-height:1.8}.context-line{font-size:clamp(19px,1.65vw,31px);line-height:1.65;color:#59665d;margin-bottom:1.6vh}.word{display:inline;padding:0;background:none;border-radius:2px;line-height:inherit;font-size:inherit;box-decoration-break:clone;-webkit-box-decoration-break:clone;transition:background .4s,box-shadow .4s}.word:hover{background:#e9dcb655}.word.marked{background:#edda9b77;box-shadow:0 3px 0 #aa7e3d}.word:focus-visible{outline-offset:1px}.reading-footer{display:flex;justify-content:center;align-items:center;gap:1.8vw;margin-top:auto;padding-top:1.5vh;font-size:var(--small);color:#586b5d}.scale-row{display:flex;gap:1vw;justify-content:center}.soft-button{background:#edf0e6;padding:.65em 1.1em;border-radius:40px;border:1px solid #c6d1bc;font-size:var(--small);transition:.3s}.soft-button.active{background:#d1dfc3;border-color:#6a875f}.soft-button:hover{background:#e0e9d4}.intro-title{position:absolute;left:8.5vw;top:18vh;color:#fffbea;text-shadow:0 3px 24px #1c322c80}.intro-title h1{font-size:clamp(45px,5.9vw,112px);line-height:1.35;font-weight:500;letter-spacing:.09em}.intro-title .thin-line{width:4.5vw;height:2px;background:#f7edc8;margin:3vh 0}.intro-title p{font-size:clamp(20px,1.8vw,34px);letter-spacing:.15em}.enter-button{display:flex;align-items:center;gap:20px;background:#fff9e8f0;border:1px solid #e7dfc2;padding:.9em 1.7em;margin-top:4vh;border-radius:40px;font-size:clamp(18px,1.6vw,29px);box-shadow:0 8px 30px #183b3530;transition:.3s}.enter-button:hover{background:#fff;transform:translateX(4px)}.hero{position:absolute;width:clamp(180px,22vw,420px);height:clamp(180px,22vw,420px);background-image:var(--sprite);background-size:400% 200%;background-repeat:no-repeat;filter:drop-shadow(0 12px 10px #20382b27);z-index:3;pointer-events:none}.pose-0{background-position:0 0}.pose-1{background-position:33.333% 0}.pose-2{background-position:66.667% 0}.pose-3{background-position:100% 0}.pose-4{background-position:0 100%}.pose-5{background-position:33.333% 100%}.pose-6{background-position:66.667% 100%}.pose-7{background-position:100% 100%}.cover-hero{right:14vw;bottom:3vh;width:31vw;height:31vw;max-width:480px;max-height:480px}.walking{animation:walkAcross 16s ease-in-out forwards,footstep .9s steps(1) infinite}.walk-bob{animation:walkBob .9s ease-in-out infinite}.intro-word{position:absolute;left:50%;top:16%;transform:translateX(-50%);white-space:nowrap;color:#fffaf0;font-family:var(--serif);font-size:clamp(38px,4.3vw,82px);letter-spacing:.12em;text-shadow:0 2px 24px #1b332b80}.memory-note{position:absolute;top:16vh;left:16vw;width:68vw;background:#fff9edee;padding:3vh 4vw;box-shadow:0 12px 55px #33261830;border-radius:4px;text-align:center;font-size:clamp(28px,3vw,57px);font-family:var(--serif);line-height:1.8}.pencil-sketch{position:absolute;bottom:17%;left:45%;width:17vw;height:1.15vw;background:linear-gradient(#dab45f,#a37631 55%,#edce83);border-radius:4px;transform:rotate(-8deg);box-shadow:0 4px 8px #402b2533}.pencil-sketch:after{content:'';position:absolute;right:-2vw;top:0;border-top:.58vw solid transparent;border-bottom:.58vw solid transparent;border-left:2vw solid #d7c5a5}.pencil-sketch:before{content:'';position:absolute;left:0;top:0;width:2.5vw;height:100%;background:#a46e59;border-radius:3px}.window-sequence{position:absolute;inset:0;perspective:1600px;overflow:hidden}.portal-world{position:absolute;inset:0;background:var(--old-room) center/cover;clip-path:inset(3% 22% 28% 25%);animation:portalTravel 6.5s cubic-bezier(.33,.02,.18,1) forwards}.window-doors{position:absolute;left:25%;top:3%;width:53%;height:69%;perspective:1300px;animation:doorZoom 6.5s ease-in-out forwards}.window-pane{position:absolute;top:0;height:100%;width:50%;border:11px solid #81522b;background:linear-gradient(155deg,#94acb73a,#c79c462a);box-shadow:inset 0 0 28px #ecc6a05c,0 0 10px #32261980;backdrop-filter:blur(1px)}.window-pane.left{left:0;transform-origin:left center;animation:openLeft 3s .45s both}.window-pane.right{right:0;transform-origin:right center;animation:openRight 3s .45s both}.window-pane:after{content:'';position:absolute;top:47%;width:100%;height:5px;background:#81522b}.window-hero{left:37%;bottom:8%;animation:fadeOut 1s 2s both}.book-object{position:absolute;bottom:10%;left:37%;width:26vw;height:33vw;max-height:52vh;transform:rotate(-9deg);background:#4d5e49;border-radius:6px 16px 16px 6px;box-shadow:inset 10px 0 0 #314634,10px 10px 0 #e9e1c8,13px 16px 30px #0006;display:flex;align-items:center;justify-content:center;color:#e9dcb8;border:1px solid #7f926e;animation:bookRise 2.5s ease-out both}.book-object:before{content:'';position:absolute;inset:8%;border:1px solid #b1b082}.book-object span{font-family:var(--serif);font-size:clamp(40px,5vw,95px);letter-spacing:.2em;padding-left:.2em}.arrival-caption{position:absolute;top:9%;left:0;width:100%;text-align:center;color:#fff6df;font-size:clamp(28px,3vw,57px);font-family:var(--serif);letter-spacing:.15em;text-shadow:0 2px 20px #000}.book-reading{border-radius:4px 13px 15px 4px;background:linear-gradient(90deg,#fffaf0 0%,#fffaf0 48.8%,#e4d9c4 49.8%,#fffaf0 51%,#fffaf0 100%)}.picture-crop{width:min(92vw,1700px);position:relative;overflow:hidden;box-shadow:0 20px 70px #13160e70;border:clamp(8px,1.1vw,20px) solid #eee6ce;outline:1px solid #997d4f}.picture-crop img{display:block;width:100%;transition:transform 1.7s ease-in-out;transform-origin:28% 50%}.art-caption{position:absolute;left:50%;bottom:4vh;transform:translateX(-50%);font-family:var(--serif);font-size:clamp(24px,2.4vw,45px);color:#fff9e7;text-shadow:0 1px 15px #000c;white-space:nowrap}.art-actions{position:absolute;top:5vh;left:50%;transform:translateX(-50%);display:flex;gap:12px;z-index:2}.art-actions button{background:#fffaedeb;padding:.45em 1.2em;border-radius:50px;font-size:var(--small)}.grandfather-grid{display:grid;grid-template-columns:1fr 1fr;gap:3vw}.grandfather-grid .fragment{font-size:clamp(21px,1.8vw,34px);line-height:1.65}.grandfather-grid h2{margin-bottom:1.5vh;font-size:clamp(25px,2.3vw,44px)}.quiet-question{background:#fffbf0f7;padding:6vh 4vw;width:91vw;max-width:1720px;text-align:center;border-radius:8px;box-shadow:0 20px 80px #0003}.quiet-question h1{font-size:clamp(32px,3.65vw,69px);line-height:1.75}.quiet-question strong{font-weight:700;color:#8b5538}.rules-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:2vw;margin:3vh 0}.rule-card{border:1px solid #dbcfb5;border-radius:3px;background:#faf4e6;min-height:25vh;padding:3vh 1.5vw;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:2vh;box-shadow:0 10px 18px #71604215}.rule-card .line-icon{font-size:clamp(38px,4.4vw,82px);font-family:var(--serif);color:#987443}.rule-card h2{font-size:clamp(25px,2.5vw,47px)}.rules-flow{text-align:center;font-size:var(--read);line-height:1.8}.single-reading{width:min(88vw,1550px);padding:5vh 5vw}.single-reading h1{margin-bottom:3vh;text-align:center}.single-reading .fragment{font-size:clamp(26px,2.5vw,47px);line-height:1.95}.recall-paper{width:80vw;min-height:58vh;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4vh;padding:5vh;animation:turnFace .8s ease both}.recall-paper h1{font-size:clamp(37px,4vw,76px)}.recall-line{width:55%;height:1px;background:#ab9f85}.repair-layout{width:92vw;max-width:1720px;max-height:88vh;padding:3vh 3.5vw;display:flex;flex-direction:column;gap:1.8vh}.repair-layout h1{font-size:clamp(29px,2.8vw,53px);text-align:center}.repair-layout .fragment{font-size:clamp(22px,1.95vw,37px);line-height:1.8}.repair-source{padding:1.3vh 0 2vh;border-bottom:1px solid #d8ceb8}.repair-target{padding:1.6vh 2vw;background:#f4eddb;border-radius:4px;position:relative}.repair-target .card-sentence{font-size:clamp(27px,2.8vw,53px);font-family:var(--serif);line-height:1.65}.editable{font-size:clamp(23px,2.2vw,42px);line-height:1.6;min-height:1.8em;padding:.1em .2em;border-bottom:1px solid #a5b49a;outline:0;white-space:pre-wrap;overflow-wrap:anywhere;color:#355941}.editable:empty:before{content:attr(data-placeholder);color:#73806d}.repair-bottom{display:flex;justify-content:space-between;gap:2vw;align-items:center}.done-button{flex-shrink:0;background:#54725b;color:#fffaf0;padding:.6em 1.2em;border-radius:28px;font-size:var(--small)}.done-button.completed{background:#bb9858}.bookmark{display:none;position:absolute;right:3vw;top:0;width:30px;height:65px;background:#b69853;clip-path:polygon(0 0,100% 0,100% 100%,50% 77%,0 100%)}.is-complete .bookmark{display:block;animation:bookmarkDown .6s ease both}.cause-line{display:grid;grid-template-columns:1fr 60px 1fr 60px 1.3fr;align-items:center;gap:1vw;margin:1.5vh 0}.cause-node{font-size:clamp(24px,2.4vw,45px);line-height:1.6;text-align:center;padding:1.5vh .8vw;background:#f3eddd;border-radius:3px;min-height:13vh;display:flex;align-items:center;justify-content:center}.cause-arrow{font-size:clamp(38px,4vw,76px);background:transparent;position:relative}.cause-arrow.cut:after{content:'';position:absolute;width:8px;height:65%;top:18%;left:48%;background:#fffaf0;border-left:2px solid #9a644d;border-right:2px solid #9a644d;transform:rotate(25deg);animation:strokeIn .4s}.protect-figure{position:absolute;bottom:0;right:1vw;width:auto;height:100%;max-height:22vh;aspect-ratio:1;background-image:var(--protectors);background-size:200% 100%;background-position:100% 0;background-repeat:no-repeat;opacity:.08;transform:translateX(2vw);transition:opacity 1s,transform 1s;pointer-events:none}.has-protection .protect-figure{opacity:.92;transform:none}.protect-layout .repair-target{padding-right:20vw}.protect-layout .repair-source{position:relative}.warm-glow{position:absolute;right:1%;bottom:0;width:30%;height:70%;background:radial-gradient(ellipse,#fbd98c80,transparent 65%);opacity:0;transition:opacity 1s;pointer-events:none}.has-love .warm-glow{opacity:1}.dialogue-paper{width:86vw;max-width:1540px;padding:4.5vh 4vw}.dialogue{font-family:var(--serif);font-size:clamp(36px,4.2vw,79px);line-height:1.7}.dialogue+.dialogue{margin-top:4vh;text-align:right}.dialogue small{display:block;font-family:var(--sans);font-size:var(--small);color:#6b7769;margin-bottom:.5vh}.dialogue-paper .hint{margin-top:4vh;text-align:center}.anne-context{width:86vw;max-width:1550px;padding:4.5vh 5vw}.anne-context h1{text-align:center;margin-bottom:2.5vh}.anne-context p{font-size:clamp(29px,3vw,57px);line-height:1.8}.help-items{display:flex;gap:3vw;justify-content:center;margin:3vh 0}.help-item{padding:2vh 3vw;border:1px solid #d3c7a7;border-radius:4px;background:#fbf6e9;font-size:clamp(30px,3vw,57px);font-family:var(--serif);animation:itemArrive .9s both}.help-item:nth-child(2){animation-delay:.25s}.help-item:nth-child(3){animation-delay:.5s}.wish-text{font-family:var(--serif);font-size:clamp(37px,4.05vw,76px)!important;line-height:1.9!important;text-align:center!important}.wish-scenes{height:16vh;display:flex;justify-content:center;align-items:center;gap:5vw;color:#8f986f}.wish-picture{width:10vw;max-width:180px;height:13vh;opacity:.12;transform:translateY(10px);transition:1.2s;pointer-events:none}.wish-picture.visible{opacity:.8;transform:none}.wish-picture svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.wish-picture.visible .bike-wheel{transform-box:fill-box;transform-origin:center;animation:rotateWheel 5s linear 1}.group-layout{width:94vw;max-width:1800px;max-height:88vh;padding:1.8vh 2.5vw;display:flex;flex-direction:column;gap:1.5vh}.group-layout h1{font-size:clamp(28px,3vw,57px);text-align:center}.evidence-board{display:grid;grid-template-columns:1.08fr 1.08fr 1.15fr;gap:1.4vw}.evidence-stack{display:flex;flex-direction:column;gap:1.5vh}.evidence-bit{background:#f5efdf;border:1px solid #dfd4bb;border-radius:4px;padding:1.1vh 1.2vw;text-align:left;flex:1;transition:background .2s}.evidence-bit:hover{background:#eee6cf}.evidence-bit h3{font-size:clamp(19px,1.7vw,32px);margin-bottom:.8vh;color:#607052}.evidence-bit p{font-size:clamp(19px,1.6vw,30px);line-height:1.6}.group-prompt{font-size:clamp(19px,1.8vw,34px);line-height:1.65;background:#f0f2e9;padding:1.3vh 1.3vw;border-radius:4px}.group-steps{font-size:clamp(16px,1.35vw,25px);display:flex;justify-content:space-between;color:#6a755e;padding-top:.8vh}.share-grid{display:grid;grid-template-columns:1fr 1fr;gap:2vw}.share-card{padding:2.5vh 2vw;min-height:32vh;background:#f4f0e3;border:1px solid #d5cbb6;border-radius:4px}.share-card h2{font-size:clamp(24px,2.3vw,44px);margin-bottom:1.5vh}.share-card .editable{font-size:clamp(24px,2.3vw,44px)}.daily-options{display:flex;gap:1vw;justify-content:center;flex-wrap:wrap}.daily-response{font-size:var(--read);line-height:1.8;text-align:center;min-height:3.5em;padding:1.5vh 1vw;color:#3f5f46}.author-fragments{display:grid;grid-template-columns:1fr 1fr;gap:2vw}.author-fragments .fragment{font-size:clamp(23px,2vw,38px);line-height:1.8;padding:1.5vh 1vw}.author-fragments .fragment:first-child{border-right:1px solid #d6cbb3;padding-right:2.5vw}.author-tail{border-top:1px solid #d6cbb3;padding-top:1.8vh;font-size:clamp(23px,2vw,38px);line-height:1.8}.bubble-room{position:absolute;inset:0}.bubble{position:absolute;width:clamp(170px,23vw,430px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 28% 23%,#ffffffa8 0,transparent 27%),radial-gradient(circle,#fff8dd45,#e4f1ee65 70%,#fff9eab3);box-shadow:inset 0 0 0 2px #ffffffa6,inset -15px -15px 35px #849b9840,0 15px 55px #536b5c30;overflow:hidden;border:1px solid #fff8;display:flex;align-items:center;justify-content:center;transition:transform .7s,box-shadow .7s}.bubble img{position:absolute;inset:9%;width:82%;height:82%;object-fit:cover;border-radius:50%;opacity:.82;filter:saturate(.68)}.bubble:after{content:'';position:absolute;inset:7%;border:1px solid #ffffff70;border-radius:50%;pointer-events:none}.bubble span{position:absolute;bottom:16%;left:8%;right:8%;padding:.4em;background:#fff9e9e8;color:#344b3e;font-size:clamp(21px,2.15vw,41px);font-family:var(--serif);text-align:center;border-radius:3px}.bubble:hover{transform:translateY(-8px);box-shadow:inset 0 0 0 2px #fff,0 20px 65px #536b5c50}.bubble-one{left:15%;top:16%;animation:bubbleEnter 1.6s both}.bubble-two{right:13%;top:10%;animation:bubbleEnter 1.6s .3s both}.bubble-small{width:14vw;left:45%;top:10%;opacity:.5;pointer-events:none;box-shadow:inset 0 0 0 2px #fff8}.bubble-small span{font-size:clamp(18px,1.6vw,30px);bottom:34%;background:none}.bubble-hero{left:36%;bottom:2%;width:23vw;height:23vw}.bubble-room .intro-word{top:auto;bottom:3vh;font-size:clamp(25px,2.5vw,47px);color:#435843;text-shadow:0 1px 10px #fff}.documentary{width:91vw;max-width:1700px;min-height:70vh;display:grid;grid-template-columns:30% 1fr;overflow:hidden;padding:0;background:#fffdf5f7;animation:bubbleFocus 1.1s cubic-bezier(.18,.72,.18,1) both}.documentary-photo{min-height:70vh;overflow:hidden;position:relative}.documentary-photo img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;object-position:50% 40%;filter:saturate(.9)}.documentary-content{display:flex;flex-direction:column;justify-content:center;text-align:center;padding:4vh 4vw;gap:3.2vh}.documentary-content h1{font-size:clamp(40px,4.3vw,82px)}.documentary-content p{font-size:clamp(30px,3.2vw,61px);line-height:1.9}.documentary-content .name{font-size:var(--small);color:#74806d;letter-spacing:.1em}.pressure-scene{position:absolute;inset:0}.pressure-shadow{position:absolute;left:-5%;width:110%;top:-45%;height:90%;background:linear-gradient(#334043f0,#4c5556c9 60%,#59666b00);border-radius:0 0 45% 45%;animation:pressureDown 5s ease-in-out forwards;pointer-events:none}.pressure-bubbles{position:absolute;inset:0;opacity:.52}.pressure-bubbles .bubble{width:17vw;top:14%;filter:saturate(.4);pointer-events:none}.pressure-bubbles .bubble-one{left:8%}.pressure-bubbles .bubble-two{right:8%}.pressure-words{position:absolute;left:5%;right:5%;top:12%;display:flex;justify-content:space-around;color:#f9f1db;font-size:clamp(24px,2.8vw,53px);font-family:var(--serif);z-index:5;text-shadow:0 2px 18px #0008;animation:wordsDescend 5s ease-in-out both}.pressure-hero{left:40%;bottom:4%;width:24vw;height:24vw;animation:shoulderFall 5s ease-in-out both}.pressure-question{position:absolute;left:17%;right:17%;bottom:2%;text-align:center;background:#fff9edee;padding:1.5vh 2vw;border-radius:4px;font-family:var(--serif);font-size:clamp(30px,3.3vw,63px);line-height:1.6;z-index:6;animation:fadeIn 1s 4s both}.exit-paper{width:90vw;max-width:1650px;padding:4vh 5vw}.exit-paper h1{text-align:center;margin-bottom:3vh}.exit-lines{display:flex;flex-direction:column;gap:3.5vh}.exit-line{font-size:clamp(28px,2.7vw,51px);line-height:1.9}.blank{display:inline-block;min-width:5em;border-bottom:1px solid #67825e;margin:0 .15em}.beam{position:absolute;left:0;top:27%;width:100%;height:6vh;background:linear-gradient(#715e41,#4a3a29);box-shadow:0 9px 18px #1f241b50;transform:rotate(1.5deg);animation:beamLift 5s ease-in-out both}.support-hands{position:absolute;inset:0;width:100%;height:100%;z-index:4;animation:handsLift 5s ease-in-out both}.support-caption{position:absolute;bottom:7%;width:100%;text-align:center;color:#fff8de;font-family:var(--serif);font-size:clamp(30px,3.5vw,66px);text-shadow:0 2px 16px #0008}.ending-card{position:absolute;left:10%;right:10%;top:12%;padding:4vh 3vw;background:#fff9e9ee;border-radius:4px;text-align:center;box-shadow:0 20px 70px #2e241f30;z-index:6;animation:fadeIn 1.5s 3s both}.ending-card h1{font-size:clamp(38px,4.3vw,82px);line-height:1.75}.ending-hero{right:24%;bottom:2%;width:22vw;height:22vw}.ending-pencil{animation:pencilRoll 4.5s .3s both;bottom:18%;left:35%;width:13vw}.catch-hand{position:absolute;left:55%;bottom:7%;width:23vw;height:18vw;animation:handCatch 5s both;z-index:5}.homework-paper{width:85vw;max-width:1550px;padding:4vh 5vw}.homework-paper h1{text-align:center;margin-bottom:2.5vh}.homework-paper p{font-size:clamp(29px,2.8vw,53px);line-height:1.9}.homework-paper .hint{font-size:var(--small);margin-top:2vh}.fade-in{animation:fadeIn 1s both}.quiet-glow{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 60%,#ffc86730,transparent 70%);pointer-events:none}#controls{position:fixed;bottom:16px;right:20px;display:flex;gap:6px;z-index:30;padding:5px;border-radius:35px;background:#fcf9efeb;box-shadow:0 3px 25px #1b2f2533;opacity:0;transform:translateY(7px);transition:.3s;backdrop-filter:blur(10px)}#controls.show,#controls:focus-within,#controls:hover{opacity:1;transform:none}#controls button{width:41px;height:41px;border-radius:50%;background:transparent;font-size:23px;line-height:1;display:grid;place-items:center;color:#52664f}#controls button:hover{background:#dde6d1}#controls .next-control{background:#4a6751;color:#fff}#controls button[aria-pressed=true]{background:#e7d7ad}#progress{position:absolute;bottom:0;left:0;right:0;height:3px;z-index:25;background:#ffffff18;pointer-events:none}#progress span{display:block;height:100%;background:#ccb675;transition:width .5s;width:0}#timer{position:absolute;top:1.5vh;right:1.8vw;z-index:20;display:flex;align-items:center;gap:4px}#timer[hidden]{display:none}#timerToggle{position:relative;width:64px;height:64px;background:#fffaf0e8;border-radius:50%;box-shadow:0 3px 14px #20392b20;display:flex;align-items:center;justify-content:center}#timerToggle svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}#timerToggle circle{fill:none;stroke-width:2}.timer-track{stroke:#d7ddcd}#timerRing{stroke:#6d875c;stroke-dasharray:144.513;stroke-dashoffset:0;transition:stroke-dashoffset 1s linear}#timerValue{font:12px var(--sans);font-variant-numeric:tabular-nums;color:#4d6547}#timerReset{width:27px;height:27px;border-radius:50%;background:#fffaf0c9;color:#617452}#timer.finished #timerRing{stroke:#ba9c58}#toast{position:absolute;bottom:80px;left:50%;transform:translateX(-50%);padding:12px 25px;border-radius:30px;background:#2d443de8;color:#fff;font-size:18px;z-index:50;opacity:0;pointer-events:none;transition:.3s}#toast.visible{opacity:1}#pageTurn{position:absolute;left:50%;top:0;width:50%;height:100%;background:linear-gradient(90deg,#e6dcc2,#fffbef 10%,#fff9e8);transform-origin:left center;transform:rotateY(0deg);opacity:0;pointer-events:none;z-index:15;box-shadow:-15px 0 30px #0002}.page-ridge{position:absolute;left:3%;top:6%;bottom:6%;width:1px;background:#c4b68a}.page-turning{animation:pageTurn 1.1s cubic-bezier(.35,.03,.26,1) both}dialog{width:min(94vw,1180px);max-height:90vh;border:1px solid #d9d0b9;background:#fffcf3;border-radius:12px;box-shadow:0 25px 100px #0007;color:#2c3e34;padding:0}dialog::backdrop{background:#14231fd1;backdrop-filter:blur(8px)}.panel-top{display:flex;align-items:center;justify-content:space-between;padding:22px 30px;border-bottom:1px solid #e5ddc7;position:sticky;top:0;background:#fffcf3;z-index:2}.panel-top h2{font-size:27px}.panel-top button{font-size:34px;background:none;width:40px;height:40px}#panelBody{padding:24px 30px;max-height:76vh;overflow:auto;font-size:18px;line-height:1.9}#panelBody h3{font-family:var(--sans);font-size:23px;margin:22px 0 10px}#panelBody p{margin:10px 0}#panelBody a{color:#49765d}#panelBody pre{white-space:pre-wrap;font-family:inherit;font-size:15px;line-height:1.8}#panelBody .teacher-speech{font-size:22px;line-height:1.9;color:#243c2d;white-space:pre-wrap}.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.menu-grid button{background:#f0edde;border:1px solid #d7d1bc;border-radius:5px;padding:14px;text-align:left;font-size:17px;line-height:1.6}.menu-grid button.current{background:#dce7d0;border-color:#819b71}.menu-grid button small{display:block;font-size:13px;color:#79836b}.menu-actions{display:flex;gap:12px;margin-bottom:22px;flex-wrap:wrap}.menu-actions button{background:#49684f;color:#fff;padding:9px 18px;border-radius:25px;font-size:16px}.notes-meta{color:#7f7153;font-size:16px}.note-list{padding-left:1.2em}.evidence-modal .fragment{font-size:clamp(25px,2.1vw,38px);line-height:1.8}.sources-list{font-size:16px}.stage-still *,.reduce-motion *{animation-duration:.001ms!important;animation-delay:0ms!important;transition-duration:.001ms!important}body.high-contrast #shade{background:#132b2bb8!important}body.high-contrast .paper{background:#fffdf4}body.high-contrast .fragment,body.high-contrast .context-line{color:#182c20}
@keyframes walkAcross{0%{left:6%;bottom:3%;transform:scale(.92)}40%{left:33%;bottom:6%}100%{left:58%;bottom:7%;transform:scale(.8)}}@keyframes footstep{0%,100%{background-position:0 0}50%{background-position:33.333% 0}}@keyframes walkBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}@keyframes portalTravel{0%{clip-path:inset(3% 22% 28% 25%);transform:scale(1);filter:brightness(.5)}45%{clip-path:inset(3% 22% 28% 25%);transform:scale(1);filter:brightness(.9)}100%{clip-path:inset(0);transform:scale(1.06);filter:brightness(1)}}@keyframes doorZoom{0%,35%{transform:scale(1);opacity:1}90%{opacity:1}100%{transform:scale(3.3);opacity:0}}@keyframes openLeft{to{transform:rotateY(-107deg)}}@keyframes openRight{to{transform:rotateY(107deg)}}@keyframes bookRise{from{opacity:0;transform:translateY(20vh) rotate(-22deg) scale(.6)}to{opacity:1;transform:translateY(0) rotate(-9deg) scale(1)}}@keyframes fadeOut{to{opacity:0}}@keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@keyframes turnFace{from{transform:rotateY(-95deg);opacity:.3}to{transform:rotateY(0);opacity:1}}@keyframes bookmarkDown{from{transform:translateY(-70px)}to{transform:translateY(0)}}@keyframes strokeIn{from{opacity:0;transform:rotate(25deg) scaleY(0)}to{opacity:1;transform:rotate(25deg) scaleY(1)}}@keyframes itemArrive{from{transform:translateY(20px);opacity:0}to{transform:none;opacity:1}}@keyframes rotateWheel{to{transform:rotate(180deg)}}@keyframes bubbleEnter{from{opacity:0;transform:translateY(60px) scale(.6)}to{opacity:1;transform:none}}@keyframes bubbleFocus{from{opacity:.2;clip-path:circle(8% at 23% 45%);transform:translateX(-10vw) scale(.75)}to{opacity:1;clip-path:circle(90% at 50% 50%);transform:none}}@keyframes pressureDown{to{top:-8%}}@keyframes wordsDescend{from{transform:translateY(-10vh);opacity:0}to{transform:translateY(12vh);opacity:1}}@keyframes shoulderFall{0%{transform:translateY(0) scale(1)}100%{transform:translateY(1vh) scaleY(.94)}}@keyframes beamLift{from{top:36%;transform:rotate(2deg)}to{top:27%;transform:rotate(.3deg)}}@keyframes handsLift{from{transform:translateY(19vh);opacity:0}45%{opacity:1}to{transform:translateY(0);opacity:1}}@keyframes pencilRoll{0%{transform:translateX(0) rotate(-8deg)}70%,100%{transform:translateX(15vw) rotate(9deg)}}@keyframes handCatch{0%,30%{transform:translate(23vw,5vh);opacity:0}55%,100%{transform:translate(0,0);opacity:1}}@keyframes pageTurn{0%{opacity:1;transform:perspective(1400px) rotateY(0)}94%{opacity:1}100%{opacity:0;transform:perspective(1400px) rotateY(-178deg)}}
@media(min-aspect-ratio:2/1){:root{--read:clamp(22px,3.3vh,38px);--title:clamp(32px,5.6vh,62px)}.quote-column .fragment{font-size:3.1vh}.single-reading .fragment{font-size:3.8vh}.center-paper{padding:4vh 7vw}.big-question,.quiet-question h1{font-size:5.8vh}.documentary-content p{font-size:4.6vh}.documentary-content h1{font-size:6.4vh}.intro-title h1{font-size:9vh}.hero{width:37vh;height:37vh}.cover-hero{width:55vh;height:55vh}.repair-layout .fragment{font-size:3.1vh}.evidence-bit p{font-size:2.7vh}.group-prompt{font-size:2.8vh}.exit-line{font-size:4.1vh}}
@media(max-aspect-ratio:1.45/1){.quote-column .fragment{font-size:clamp(20px,2.3vw,34px)}.quote-grid{gap:2.5vw}.main-paper{padding:3vh 3vw}.documentary{grid-template-columns:27% 1fr;min-height:60vh}.documentary-photo{min-height:60vh}.documentary-content p{font-size:clamp(27px,3.6vw,46px)}.grandfather-grid .fragment{font-size:2.15vw}.evidence-board{gap:1vw}.evidence-bit p{font-size:2vw}.group-layout h1{font-size:3.6vw}.group-prompt{font-size:2.2vw}.cause-line{grid-template-columns:1fr 40px 1fr 40px 1.2fr}.cause-node{font-size:2.7vw}.center-paper{padding:5vh 5vw}.big-question{font-size:4.8vw}.quiet-question h1{font-size:4.5vw}.intro-title{top:22vh}.cover-hero{width:37vw;height:37vw;bottom:5vh}.window-doors{top:12%;height:55%}.window-hero{bottom:12%}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;animation-delay:0ms!important;transition-duration:.001ms!important}}
/* Central reading in the documentary bubbles. */
.documentary{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:78vh;padding:2.5vh 4vw;gap:1.4vh}
.documentary-photo{height:24vh;min-height:0;width:100%;overflow:visible;display:flex;justify-content:center;align-items:center;flex:0 0 24vh}
.documentary-photo img{position:relative;inset:auto;width:auto;max-width:42vw;height:24vh;object-fit:contain;object-position:center;filter:saturate(.9);border:7px solid #fffdf5;box-shadow:0 5px 22px #3e4c3b22;border-radius:3px}
.documentary-content{padding:0 2vw;gap:1.4vh;align-items:center;max-width:100%}
.documentary-content h1{font-size:clamp(36px,3.8vw,72px)}
.documentary-content p{font-size:clamp(29px,3.05vw,58px);line-height:1.8;max-width:73vw;text-align:center}
.focus-right{animation-name:bubbleFocusRight}
.r2-source-grid{display:grid;grid-template-columns:1fr 1fr;gap:1vh 3vw}
.r2-source-grid .fragment+.fragment{margin-top:0}
.r2-source-grid .fragment{font-size:clamp(21px,1.8vw,34px)}
@keyframes bubbleFocusRight{from{opacity:.2;clip-path:circle(8% at 77% 40%);transform:translateX(10vw) scale(.75)}to{opacity:1;clip-path:circle(90% at 50% 50%);transform:none}}
.walking{animation:walkAcross 16s ease-in-out forwards,footstep .8s steps(1) 20}
.continuing-protection{position:absolute;right:1vw;bottom:1vh;width:20vw;height:20vw;background-image:var(--protectors);background-size:200% 100%;background-position:100% 0;background-repeat:no-repeat;opacity:.95;z-index:0;pointer-events:none}
.continuing-glow{position:absolute;right:-3vw;bottom:-3vh;width:30vw;height:35vh;background:radial-gradient(ellipse,#ebbd546b,transparent 70%);pointer-events:none}
.dialogue-paper{z-index:2;margin-bottom:8vh}
.group-roles{font-size:clamp(16px,1.4vw,26px);text-align:center;color:#6b765d;line-height:1.6}
.group-layout{gap:1vh}
.pressure-question{top:40%;bottom:auto;left:12%;right:12%;padding:2.4vh 3vw;font-size:clamp(34px,3.8vw,72px)}
.descending-beam{z-index:2;animation:beamDown 5s ease-in-out forwards;opacity:.85}
.lifting-shadow{animation:shadowLift 5s ease-in-out forwards}
@keyframes beamDown{from{top:14%;transform:rotate(-.5deg)}to{top:36%;transform:rotate(1.5deg)}}
@keyframes shadowLift{from{top:-8%}to{top:-25%}}
@media(max-aspect-ratio:1.45/1){.portal-world{animation-name:portalTravelNarrow}}
@keyframes portalTravelNarrow{0%{clip-path:inset(12% 22% 33% 25%);transform:scale(1);filter:brightness(.5)}45%{clip-path:inset(12% 22% 33% 25%);transform:scale(1);filter:brightness(.9)}100%{clip-path:inset(0);transform:scale(1.06);filter:brightness(1)}}
</style>
