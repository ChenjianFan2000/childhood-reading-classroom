<body>
<main id="stage" aria-label="童年阅读课堂">
  <div id="background" aria-hidden="true"></div>
  <div id="shade" aria-hidden="true"></div>
  <div id="grain" aria-hidden="true"></div>
  <section id="scene" aria-label="课堂画面"></section>
  <div id="pageTurn" aria-hidden="true"><div class="page-ridge"></div></div>
  <nav id="controls" aria-label="课堂控制">
    <button data-command="previous" title="上一步 ←" aria-label="上一步">←</button>
    <button data-command="menu" title="目录 M" aria-label="打开目录">☰</button>
    <button data-command="replay" title="重播本幕 R" aria-label="重播本幕">↺</button>
    <button data-command="timer" title="计时 T" aria-label="开始或暂停计时">◷</button>
    <button data-command="sound" title="音效" aria-label="开启音效">♪</button>
    <button data-command="fullscreen" title="全屏 F" aria-label="进入全屏">⛶</button>
    <button data-command="notes" title="教师讲稿 N" aria-label="打开教师讲稿">文</button>
    <button class="next-control" data-command="next" title="下一步 → / 空格" aria-label="下一步">→</button>
  </nav>
  <div id="progress" aria-hidden="true"><span></span></div>
  <div id="timer" hidden><button id="timerToggle" aria-label="开始或暂停计时"><svg viewBox="0 0 54 54" aria-hidden="true"><circle class="timer-track" cx="27" cy="27" r="23"/><circle id="timerRing" cx="27" cy="27" r="23"/></svg><span id="timerValue">00:00</span></button><button id="timerReset" aria-label="重置计时" title="重置">↺</button></div>
  <div id="toast" role="status"></div>
</main>
<dialog id="panel" aria-label="教师面板"><div class="panel-top"><h2 id="panelTitle"></h2><button id="closePanel" aria-label="关闭面板">×</button></div><div id="panelBody"></div></dialog>
